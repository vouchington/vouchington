import {
  nativeKeyIdentifier,
  renderDotnetDescriptors,
  renderDotnetKeys,
  renderResx,
  renderSwiftDescriptors,
  renderSwiftKeys,
  renderSwiftStrings,
  type GeneratedNativeFile,
  type NativeResourceEntry,
} from '@vouchington/localization-compiler'
import { isMessageDescriptor, type MessageDescriptor } from './message-descriptors.mts'
import {
  NATIVE_CONSUMER_MANIFEST,
  type NativeConsumer,
  type NativeConsumerManifestEntry,
} from './native-consumer-manifest.mts'
import {
  DEFAULT_NATIVE_CATALOGS,
  NATIVE_RESOURCE_LOCALES,
  getNativeCatalogLeaf,
  nativeLeafVariants,
  validateNativeManifestCatalogs,
  type NativeCatalogs,
  type NativeResourceLocale,
} from './native-resource-catalog.mts'

const GENERATED_HEADER = '// Generated by pnpm run native-localization:generate. Do not edit.'
const DOTNET_NAMESPACE = 'Voucha.Client.Core.Localization'
const swiftIdentifier = (key: string) => nativeKeyIdentifier(key, 'swift')
const dotnetIdentifier = (key: string) => nativeKeyIdentifier(key, 'dotnet')

export function generateNativeResourceFiles(options?: {
  manifest?: readonly NativeConsumerManifestEntry[]
  catalogs?: NativeCatalogs | undefined
}): GeneratedNativeFile[] {
  const manifest = options?.manifest ?? NATIVE_CONSUMER_MANIFEST
  const catalogs = options?.catalogs ?? DEFAULT_NATIVE_CATALOGS
  validateNativeManifestCatalogs(manifest, catalogs)
  const files = NATIVE_RESOURCE_LOCALES.flatMap(locale => [
    {
      path: `swift-clients/ui/Sources/VouchaLocalization/Generated/Resources/${locale}.lproj/Localizable.strings`,
      content: renderSwiftStrings(entriesForConsumer('swift', locale, manifest, catalogs), {
        headerComment: GENERATED_HEADER,
      }),
    },
    {
      path: `dotnet-clients/src/Voucha.Client.Core/Localization/Generated/UiMessages${locale === 'en' ? '' : `.${locale}`}.resx`,
      content: renderResx(entriesForConsumer('dotnet', locale, manifest, catalogs)),
    },
  ])
  files.push(
    {
      path: 'swift-clients/ui/Sources/VouchaLocalization/Generated/UiMessageKey.swift',
      content: renderSwiftKeys(keysForConsumer('swift', manifest), swiftIdentifier, {
        headerComment: GENERATED_HEADER,
      }),
    },
    {
      path: 'swift-clients/ui/Sources/VouchaLocalization/Generated/UiMessageDescriptor.swift',
      content: renderSwiftDescriptors(
        descriptorRows('swift', manifest, catalogs),
        swiftIdentifier,
        { headerComment: GENERATED_HEADER },
      ),
    },
    {
      path: 'dotnet-clients/src/Voucha.Client.Core/Localization/Generated/UiMessageKey.g.cs',
      content: renderDotnetKeys(keysForConsumer('dotnet', manifest), dotnetIdentifier, {
        headerComment: GENERATED_HEADER,
        namespace: DOTNET_NAMESPACE,
        includeAll: true,
      }),
    },
    {
      path: 'dotnet-clients/src/Voucha.Client.Core/Localization/Generated/UiMessageDescriptor.g.cs',
      content: renderDotnetDescriptors(
        descriptorRows('dotnet', manifest, catalogs),
        dotnetIdentifier,
        {
          headerComment: GENERATED_HEADER,
          namespace: DOTNET_NAMESPACE,
          kindEnum: true,
        },
      ),
    },
  )
  return files.toSorted((left, right) => compareCodePoints(left.path, right.path))
}

function keysForConsumer(
  consumer: NativeConsumer,
  manifest: readonly NativeConsumerManifestEntry[],
): string[] {
  return manifest.flatMap(entry => (entry.consumers.includes(consumer) ? [entry.key] : []))
}

function entriesForConsumer(
  consumer: NativeConsumer,
  locale: NativeResourceLocale,
  manifest: readonly NativeConsumerManifestEntry[],
  catalogs: NativeCatalogs,
): NativeResourceEntry[] {
  return manifest.flatMap(entry =>
    entry.consumers.includes(consumer)
      ? nativeLeafVariants(entry.key, getNativeCatalogLeaf(catalogs[locale], entry.key))
      : [],
  )
}

function descriptorRows(
  consumer: NativeConsumer,
  manifest: readonly NativeConsumerManifestEntry[],
  catalogs: NativeCatalogs,
): Array<readonly [string, MessageDescriptor]> {
  return manifest.flatMap(entry => {
    if (!entry.consumers.includes(consumer)) return []
    const descriptor = getNativeCatalogLeaf(catalogs.en, entry.key)
    return isMessageDescriptor(descriptor) ? ([[entry.key, descriptor]] as const) : []
  })
}

function compareCodePoints(left: string, right: string): number {
  return left < right ? -1 : left > right ? 1 : 0
}
