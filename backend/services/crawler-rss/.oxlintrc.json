{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "extends": ["../../../.oxlintrc.json"],
  // "extends" does not inherit the root "plugins" array — keep this in exact sync with it. See
  // docs/development/quality/static-code-analysis/README.md nested .oxlintrc.json section for why.
  "plugins": [
    "react",
    "nextjs",
    "jsx-a11y",
    "react-perf",
    "vitest",
    "jest",
    "promise",
    "oxc",
    "typescript",
    "unicorn",
    "import",
    "node"
  ],
  "rules": {
    // Source: backend/AGENTS.md line 10. Repeats the root runtime override (nested configs lose it).
    "no-mistakes/forbidden-member-chains": [
      "error",
      {
        "chains": [
          {
            "path": "process.kill",
            "message": "Runtime code never calls process.kill(); register addGracefulShutdownCallback() instead (backend/AGENTS.md)."
          },
          {
            "path": "process.exit",
            "message": "Runtime code never calls process.exit() directly; register addGracefulShutdownCallback() instead. Only an unref'd timed forced-exit fallback may exit (backend/AGENTS.md)."
          }
        ]
      }
    ],
    "no-mistakes/postgres-no-nonliteral-sql-registry-key": [
      "error",
      { "importSpecifier": "@data-stores/psql" }
    ],
    "no-mistakes/postgres-no-correlated-sql-builder": [
      "error",
      { "builderMethods": ["append"], "tagNames": ["sql"] }
    ],
    "no-mistakes/postgres-no-manual-transaction": [
      "error",
      {
        "importSpecifier": "@data-stores/psql",
        "executorFactoryNames": ["beginTransaction", "beginBoundedTransaction"],
        "executorTypeNames": ["TransactionQuery", "QueryExecutor"],
        "owners": [
          "backend/data-stores/psql/explain-analyze.mts",
          "backend/data-stores/psql/migration-runner/config-driven-statements.mts",
          "backend/test-helpers/postgres-advisory-lock.mts",
          "backend/test-helpers/crawl-urls-queue-lock.mts",
          "backend/test-helpers/entities/moderation-transparency-date-reservation.mts"
        ]
      }
    ],
    "no-mistakes/postgres-no-unbounded-query-fanout": [
      "error",
      {
        "importSpecifier": "@data-stores/psql",
        "executorFactoryNames": ["beginTransaction", "beginBoundedTransaction"],
        "executorTypeNames": ["TransactionQuery", "QueryExecutor"]
      }
    ],
    "no-mistakes/async-call-disposition": [
      "error",
      {
        "targets": [
          {
            "sourceSpecifierPatterns": ["@queues/**/enqueues", "@queues/**/enqueues/**"],
            "calleeNamePatterns": ["/^enqueue[A-Z].*/"]
          }
        ],
        "awaitingConsumers": [
          {
            "sourceSpecifierPatterns": ["@queues/background/enqueues"],
            "calleeNamePatterns": ["awaitReportedEnqueueAdmission"],
            "callbackArgumentIndexes": [0]
          }
        ]
      }
    ]
  }
}
