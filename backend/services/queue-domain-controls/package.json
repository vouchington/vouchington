{
  "name": "@services/queue-domain-controls",
  "version": "1.0.0",
  "private": true,
  "description": "Operator pause state for background-queue domains",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "main": "index.mts",
  "exports": {
    ".": {
      "types": "./index.mts",
      "import": "./index.mts",
      "default": "./index.mts"
