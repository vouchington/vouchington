  "dependencies": {
    "@data-stores/psql": "workspace:^",
    "@data-stores/valkey-pubsub": "workspace:^",
    "@modules/on-error": "workspace:^",
    "@queues/background": "workspace:^",
    "sql-template-strings": "^2.2.2"
  },
  "devDependencies": {
    "@voucha/test-helpers": "workspace:^"
  }
}
