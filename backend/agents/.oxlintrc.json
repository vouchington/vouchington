{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "extends": ["../../.oxlintrc.json"],
  // "extends" does not inherit the root "plugins" array — keep this in exact sync with it. See
  // docs/development/quality/static-code-analysis/README.md nested .oxlintrc.json section for why.
  "plugins": [
    "react",
    "nextjs",
    "jsx-a11y",
    "react-perf",
    "vitest",
    "jest",
    "promise",
    "oxc",
    "typescript",
    "unicorn",
    "import",
    "node"
  ],
  "rules": {
    // Repeats the root backend override (nested configs lose it).
    "no-mistakes/no-consecutive-unbatched-reads": [
      "error",
      {
        "clients": [
          "cacheValkeyClient",
          "sessionValkeyClient",
          "dynamicConfigValkeyClient",
          "dynamicConfigPrimaryValkeyClient",
          "rateLimiterValkeyClient",
          "bloomValkeyClient"
        ],
        "readMethods": [
          "get",
          "mget",
          "hget",
          "hgetall",
          "hmget",
          "exists",
          "ttl",
          "pttl",
          "smembers",
          "sismember",
          "zscore",
          "zrange",
          "zcard",
          "scard",
          "llen",
          "type",
          "strlen"
        ],
        "message": "Consecutive independent Valkey reads on the same client cost one round trip each. Batch the complete key set with MGET, Batch, or Lua."
      }
    ],
    "no-mistakes/postgres-no-nonliteral-sql-registry-key": [
      "error",
      { "importSpecifier": "@data-stores/psql" }
    ],
    "no-mistakes/postgres-no-correlated-sql-builder": [
      "error",
      { "builderMethods": ["append"], "tagNames": ["sql"] }
    ],
    "no-mistakes/postgres-no-async-sql-builder": [
      "error",
      { "builders": [{ "callees": ["sql"], "source": "sql-template-strings" }] }
    ],
    "no-mistakes/postgres-no-manual-transaction": [
      "error",
      {
        "importSpecifier": "@data-stores/psql",
        "executorFactoryNames": ["beginTransaction", "beginBoundedTransaction"],
        "executorTypeNames": ["TransactionQuery", "QueryExecutor"],
        "owners": [
          "backend/data-stores/psql/explain-analyze.mts",
          "backend/test-helpers/postgres-advisory-lock.mts",
          "backend/test-helpers/crawl-urls-queue-lock.mts",
          "backend/test-helpers/entities/moderation-transparency-date-reservation.mts"
        ]
      }
    ],
    "no-mistakes/postgres-no-unbounded-query-fanout": [
      "error",
      {
        "importSpecifier": "@data-stores/psql",
        "executorFactoryNames": ["beginTransaction", "beginBoundedTransaction"],
        "executorTypeNames": ["TransactionQuery", "QueryExecutor"]
      }
    ]
  },
  "overrides": [
    {
      // Policy: Test fixtures and helpers intentionally model unchecked external and malformed data.
      "files": [
        "**/*.test.{mts,ts,tsx}",
        "**/*.spec.{mts,ts,tsx}",
        "**/__tests__/**/*.{mts,ts,tsx}",
        "**/test-helpers/**"
      ],
      "rules": {
        "no-mistakes/no-consecutive-unbatched-reads": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    }
  ]
}
