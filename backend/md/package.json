{
  "name": "@backend/md",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown content serving routes for LLM consumption",
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.mts",
  "exports": {
    ".": {
      "types": "./index.mts",
      "import": "./index.mts",
      "default": "./index.mts"
    },
    "./*": {
      "types": "./*.mts",
      "import": "./*.mts",
      "default": "./*.mts"
    },
    "./*.test.mts": null,
    "./*/__tests__/*": null
  },
  "dependencies": {
    "@jongleberry/api-server": "^2.1.0",
    "@modules/utils": "workspace:^",
    "@services/elections-votes": "workspace:^",
    "@services/entity-cache": "workspace:^",
    "@services/entity-fetch": "workspace:^",
    "@services/pagination": "workspace:^",
    "@services/posts": "workspace:^",
    "@services/search-params": "workspace:^",
    "@services/users": "workspace:^",
    "@voucha/api": "workspace:^",
    "@voucha/config": "workspace:^",
    "@voucha/types": "workspace:^"
  },
  "devDependencies": {
    "@voucha/test-helpers": "workspace:^"
  }
}
