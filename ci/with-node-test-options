#!/usr/bin/env bash
set -euo pipefail

case " ${NODE_OPTIONS:-} " in
  *" --disable-warning=DEP0205 "*) ;;
  *) export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--disable-warning=DEP0205" ;;
esac

case "${1##*/}" in
  vitest|vitest.mjs|node)
    node "$(dirname "${BASH_SOURCE[0]}")/validate-vitest-cli-timeouts.mts" "$@"
    ;;
esac

exec "$@"
