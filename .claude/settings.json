  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/codex-hooks/persist-session-id.mts\" claude"
          },
          {
            "type": "command",
            "command": "b=$(git branch --show-current 2>/dev/null); echo \"Branch: ${b:-detached}\"; echo \"Status:\"; git status --short 2>/dev/null | head -20; echo; echo \"Recent commits:\"; git log --oneline -3 2>/dev/null; echo; gh pr view --json number,title,isDraft 2>/dev/null | jq -r '\"PR: #\" + (.number | tostring) + \" \" + .title + \" (\" + (if .isDraft then \"draft\" else \"ready\" end) + \")\"' 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/tmux-agent-reminder\" session-start"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/check-fresh-base\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/check-web-init\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/check-blackboard.mts\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/journal-checkpoint.mts\" compact claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|run_terminal_command|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/codex-hooks/pre-tool-use.mts\" claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); case \"$f\" in *.ts|*.tsx|*.mts|*.mjs|*.js|*.jsx) pnpm exec oxlint --type-aware --fix --quiet \"$f\" 2>/dev/null || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); case \"$f\" in *.ts|*.tsx|*.mts|*.mjs|*.js|*.jsx) pnpm exec oxlint --type-aware \"$f\" 2>&1 || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); case \"$f\" in *.ts|*.tsx|*.mts|*.mjs|*.js|*.jsx) pnpm exec oxfmt \"$f\" 2>/dev/null || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); case \"$f\" in *.ts|*.tsx|*.mts) repo_root=\"$(git rev-parse --show-toplevel)\"; rel=\"${f#\"$repo_root\"/}\"; case \"$rel\" in backend/*) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project backend/tsconfig.json 2>/dev/null ;; email-templates/*) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project email-templates/tsconfig.json 2>/dev/null ;; web/*) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project web/tsconfig.json 2>/dev/null ;; cloudflare-worker/*) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project cloudflare-worker/tsconfig.json 2>/dev/null ;; lambdas/*) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project lambdas/tsconfig.json 2>/dev/null ;; ts-shared/*) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project ts-shared/tsconfig.json 2>/dev/null ;; *) cd \"$repo_root\" && pnpm exec tsc --noEmit --incremental --project tsconfig.json 2>/dev/null ;; esac || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); repo_root=\"$(git rev-parse --show-toplevel)\"; case \"$f\" in *.md) [ -n \"$f\" ] && path=\"$f\" && case \"$path\" in \"$repo_root\"/*) path=\"${path#\"$repo_root\"/}\";; esac && (cd \"$repo_root\" && \"$repo_root/ci/lint-links.sh\" --offline \"$path\" 2>/dev/null) || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); case \"$f\" in *.rs) rustfmt \"$f\" 2>/dev/null || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .toolInput.file_path // .toolInput.filePath // .toolInput.path // empty\" 2>/dev/null); case \"$f\" in *.lua) selene --config selene.toml \"$f\" 2>/dev/null || true ;; esac"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/codex-hooks/post-tool-use.mts\" 2>&1 || true"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode|Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/codex-hooks/post-tool-use-command.mts\" claude 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/tmux-agent-reminder\" user-prompt"
          }
        ]
      }
    ]
  },
