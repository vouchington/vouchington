      "node dev/codex-hooks/persist-session-id.mts",
      "node dev/codex-hooks/persist-session-id.mts *",
      "node dev/journal-checkpoint.mts",
      "node dev/journal-checkpoint.mts *",
      "node dev/codex-hooks/post-tool-use-command.mts",
      "node dev/codex-hooks/post-tool-use-command.mts *",
