      "Bash(./dev*/../*)",
      "Bash(node dev*/../*)",
      "Bash(chmod 777 *)",
      "Bash(cp * ~/.ssh)",
      "Bash(cp * ~/.ssh/)",
      "Bash(cp * ~/.ssh/*)",
      "Bash(curl *|bash*)",
      "Bash(curl *|sh*)",
      "Bash(dd *)",
