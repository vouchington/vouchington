{
  "permissions": {
    "allow": [
      "Bash(pnpm exec *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec oxfmt *)",
      "Bash(pnpm exec no-mistakes *)",
      "Bash(pnpm exec vouchington agent-blackboard distill classify *)",
      "Bash(./ci/lint-links.sh *)",
      "Bash(pnpm exec selene *)",
      "Bash(pnpm exec knip *)",
      "Bash(pnpm exec syncpack *)",
      "Bash(pr-shepherd *)",
      "Bash(npx vitest *)",
      "Bash(npx oxlint *)",
      "Bash(npx oxfmt *)",
      "Bash(npx no-mistakes *)",
      "Bash(no-mistakes)",
      "Bash(no-mistakes *)",
      "Bash(./dev/*)",
      "Bash(node dev/*)",
      "Bash(rm -rf .worktrees/agents-*)",
      "Bash(rm -rf .claude/worktrees/*)",
      "Bash(rm -rf .codex/worktrees/*)",
      "Bash(rm -rf .cursor/worktrees/*)",
      "Bash(rm -rf .grok/worktrees/*)",
      "Bash(rm -rf target)",
      "Bash(rm -rf */target)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git show *)",
      "Bash(git merge-base *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(gh issue *)",
      "Bash(rg *)",
      "Bash(pnpm exec ast-grep *)",
      "Bash(scc *)",
      "Bash(ps aux)",
      "Bash(ps aux *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr create --draft *)",
      "Bash(git checkout -b *)",
      "Bash(git rebase --continue)",
      "Bash(GIT_EDITOR=true git rebase --continue)",
      "Bash(git rebase --skip)",
      "Bash(git rebase --abort)",
      "Bash(git push --force-with-lease=*)",
      "Bash(pnpm lint)",
      "Bash(pnpm run lint)",
      "Bash(pnpm lint:links)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm knip)",
      "Bash(./node_modules/.bin/vitest run *)"
    ],
    "deny": [
      "Bash(FORCE_MAIN_RESET=*)",
      "Bash(export FORCE_MAIN_RESET*)",
      "Bash(next dev*)",
      "Bash(npx next dev*)",
      "Bash(pnpm exec next dev*)",
      "Bash(./dev/teardown --remove*)",
      "Bash(./dev/teardown * --remove*)",
      "Bash(./dev*/../*)",
      "Bash(node dev*/../*)",
      "Bash(rm *..*)",
      "Bash(git * --strategy-option ours*)",
      "Bash(git * --strategy-option theirs*)",
      "Bash(git * --strategy-option=ours*)",
      "Bash(git * --strategy-option=theirs*)",
      "Bash(git * -X ours*)",
      "Bash(git * -X theirs*)",
      "Bash(git * -Xours*)",
      "Bash(git * -Xtheirs*)",
      "Bash(git checkout * --ours*)",
      "Bash(git checkout * --theirs*)",
      "Bash(git checkout --ours*)",
      "Bash(git checkout --theirs*)",
      "Bash(git commit * --amend *)",
      "Bash(git commit * --amend)",
      "Bash(git commit --amend *)",
      "Bash(git commit --amend)",
      "Bash(git pull * --rebase*)",
      "Bash(git pull * -r*)",
      "Bash(git pull --rebase*)",
      "Bash(git pull -r*)",
      "Bash(git stash)",
      "Bash(git stash pop*)",
      "Bash(gh stack modify*)",
      "Bash(gh stack switch*)",
      "Bash(gh stack trunk*)",
      "Bash(gh stack submit --open*)",
      "Bash(gh stack link --open*)",
      "Bash(gh stack merge)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=$(git branch --show-current 2>/dev/null); echo \"Branch: ${b:-detached}\"; echo \"Status:\"; git status --short 2>/dev/null | head -20; echo; echo \"Recent commits:\"; git log --oneline -3 2>/dev/null; echo; gh pr view --json number,title,isDraft 2>/dev/null | jq -r '\"PR: #\" + (.number | tostring) + \" \" + .title + \" (\" + (if .isDraft then \"draft\" else \"ready\" end) + \")\"' 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/check-fresh-base\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/check-web-init\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/dev/hooks/post-edit-lint.sh\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dev/hooks/post-edit-checks.mts\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "./dev/initialize",
      "./dev/initialize *",
      "./dev/tmux",
      "./dev/tmux *",
      "./dev/stop-services",
      "./dev/stop-services *",
      "./dev/status",
      "./dev/status *",
      "./dev/reset",
      "./dev/reset *",
      "./dev/rebase-onto-main",
      "./dev/rebase-onto-main *",
      "./dev/reset-worktree",
      "./dev/reset-worktree *",
      "./dev/teardown",
      "./dev/teardown *",
      "./dev/cleanup",
      "./dev/cleanup *",
      "./dev/unstick-locks",
      "./dev/unstick-locks *",
      "./dev/valkey-logs",
      "./dev/valkey-logs *"
    ]
  }
}
