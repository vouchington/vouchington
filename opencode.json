{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "vouchington-tooling": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/node_modules/.bin/vouchington\" mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "vouchington-tooling_journal_append": "allow",
    "vouchington-tooling_journal_entries": "allow",
    "vouchington-tooling_outbox_status": "allow",
    "vouchington-tooling_outbox_flush": "allow",
    "vouchington-tooling_session_ensure": "allow",
    "vouchington-tooling_snapshot_export": "allow",
    "vouchington-tooling_session_archive": "allow"
  }
}
