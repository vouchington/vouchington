{
  "name": "voucha",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-vertical consumer intelligence platform built on human trust signals.",
  "homepage": "https://github.com/vouchington/vouchington#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington.git"
  },
  "type": "module",
  "scripts": {
    "pretest:integration:web": "bash -c 'if [ -f .env ]; then source .env; fi; node ci/setup-web-integration.mts'",
    "pretest:playwright": "bash -c '[ -n \"$CI\" ] || [ -f .env ] || { echo \"Error: .env file not found. Run ./dev/initialize web to set up this worktree.\" >&2; exit 1; }; if [ -f .env ]; then source .env; fi; node ci/setup-web-integration.mts'",
    "test": "pnpm run test:backend && pnpm run test:tooling && bash -c 'unset CF_WORKER_SECRET; node ci/run-vitest-project-group.mts default-non-backend'",
    "test:backend": "node ci/run-vitest-project-group.mts backend",
    "test:backend:default": "node ci/run-vitest-project-group.mts backend-default",
    "test:backend:analytics": "node ci/run-vitest-project-group.mts backend-analytics",
    "test:backend:core": "node ci/run-vitest-project-group.mts backend-core",
    "test:backend:modules": "node ci/run-vitest-project-group.mts backend-modules",
    "test:backend:docker": "node ci/run-vitest-project-group.mts backend-docker",
    "test:backend:aws": "node ci/run-vitest-project-group.mts backend-aws",
    "test:backend:bedrock": "node ci/run-vitest-project-group.mts backend-bedrock",
    "test:backend:openai": "node ci/run-vitest-project-group.mts backend-openai",
    "test:backend:stripe": "node ci/run-vitest-project-group.mts backend-stripe",
    "test:backend:postgres-schema": "node ci/run-vitest-project-group.mts backend-postgres-schema",
    "test:email-templates": "node ci/run-vitest-project-group.mts email-templates",
    "test:ts-shared": "node ci/run-vitest-project-group.mts ts-shared",
    "test:tooling": "node ci/tooling-test-runner.mts",
    "test:web-api": "bash -c 'if [ -f .env ]; then source .env; fi; unset CF_WORKER_SECRET; node ci/run-vitest-project-group.mts web-api \"$@\"' --",
    "test:web-api:coverage": "pnpm run coverage:suite -- web-api",
    "api-fixtures:generate": "node backend/test-helpers/api-fixtures/generate.mts",
    "api-fixtures:check": "node backend/test-helpers/api-fixtures/generate.mts --check",
    "openapi:generate": "node backend/test-helpers/api-fixtures/openapi/generate.mts",
    "openapi:check": "node backend/test-helpers/api-fixtures/openapi/generate.mts --check",
    "native-localization:check": "node dev/native-localization.mts --validate",
    "localization:catalog": "node --experimental-strip-types dev/localization/catalog.mts",
    "test:integration:web": "bash -c 'if [ -f .env ]; then source .env; fi; unset CF_WORKER_SECRET; node ci/run-vitest-project-group.mts web-integration \"$@\"' --",
    "test:integration:web:setup": "bash -c 'if [ -f .env ]; then source .env; fi; node ci/setup-web-integration.mts'",
    "test:web": "node ci/run-vitest-project-group.mts web",
    "test:web-storybook": "node ci/run-vitest-project-group.mts web-storybook",
    "test:web-storybook-browser": "STORYBOOK_BROWSER_COVERAGE=0 ./ci/with-node-test-options ./ci/run-storybook-browser-tests.mts",
    "test:lambdas": "node ci/run-vitest-project-group.mts lambdas",
    "test:cloudflare-worker": "node ci/run-vitest-project-group.mts cloudflare-worker",
    "test:portability": "VITEST_COVERAGE_SCOPE=portability node ci/run-vitest-project-group.mts portability",
    "coverage:patch": "node ci/local-patch-coverage.mts",
    "coverage:patch:affected": "node ci/coverage-local-affected.mts",
    "coverage:patch:full": "node ci/coverage-local-full.mts",
    "coverage:suite": "node ci/coverage-local-provenance.mts",
    "coverage:changed": "node ci/coverage-local-changed.mts",
    "ci:topology": "no-mistakes ci topology",
    "vouchington": "vouchington",
    "email:preview": "pnpm --dir email-templates run preview --",
    "test:smoke": "pnpm --dir backend test:smoke",
    "test:smoke:backend": "pnpm --dir backend test:smoke",
    "test:smoke:web": "pnpm --dir web test:smoke",
    "test:smoke:cloudflare-worker": "pnpm --dir cloudflare-worker test:smoke",
    "test:smoke:image-lambda": "pnpm --dir lambdas/image-resize test:smoke",
    "test:localization:tmux-smoke": "bash -c '[ -f .env ] || { echo \"Error: .env file not found. Run ./dev/initialize web to set up this worktree.\" >&2; exit 1; }; source .env; node --experimental-strip-types dev/localization/local-smoke.mts'",
    "test:playwright": "bash -c '[ -n \"$CI\" ] || [ -f .env ] || { echo \"Error: .env file not found. Run ./dev/initialize web to set up this worktree.\" >&2; exit 1; }; [ -f .env ] && source .env; [ \"$1\" = \"--\" ] && shift; ./ci/with-node-test-options node dev/playwright-server-check && ./ci/with-node-test-options playwright test \"$@\"' _",
    "db:clean": "./dev/db-clean",
    "db:migrate": "pnpm --dir backend db:migrate",
    "db:seed": "bash -c 'if [ -f .env ]; then source .env; fi; pnpm --dir backend db:seed'",
    "db:snapshot:update": "bash -c 'if [ -f .env ]; then source .env; fi; pnpm --dir backend db:snapshot:update'",
    "db:snapshot:check": "bash -c 'if [ -f .env ]; then source .env; fi; pnpm --dir backend db:snapshot:check'",
    "db:check-index-renames": "bash -c 'if [ -f .env ]; then source .env; fi; pnpm --dir backend db:check-index-renames'",
    "validate-seed-rss-feeds": "bash -c 'if [ -f .env ]; then source .env; fi; node backend/scripts/validate-seed-rss-feeds.mts'",
    "squawk": "squawk 'backend/data-stores/psql/migrations/*.sql' 'backend/data-stores/psql/config-driven/*.sql' 'backend/data-stores/psql/views/*.sql'",
    "lint": "pnpm run oxlint && pnpm run ast-grep && pnpm run oxfmt && pnpm run selene && pnpm run no-mistakes && pnpm run repo-file-policy && pnpm run typecheck",
    "ast-grep": "node static-code-analysis/run-ast-grep.mts",
    "selene": "bash -c 'git ls-files \"*.lua\" | xargs selene --config selene.toml'",
    "typecheck": "pnpm run typecheck:scripts && pnpm run typecheck:ts-shared && pnpm run typecheck:backend && pnpm run typecheck:web && pnpm run typecheck:lambdas && pnpm run typecheck:cloudflare-worker && pnpm run typecheck:playwright && pnpm run typecheck:test-helpers && pnpm run typecheck:integration-tests",
    "typecheck:scripts": "tsc --noEmit --incremental --project tsconfig.json",
    "typecheck:ts-shared": "tsc --noEmit --incremental --project ts-shared/tsconfig.json",
    "typecheck:backend": "pnpm --dir backend typecheck",
    "typecheck:web": "pnpm --dir web typecheck",
    "typecheck:lambdas": "tsc --noEmit --incremental --project lambdas/tsconfig.json",
    "typecheck:cloudflare-worker": "pnpm --dir cloudflare-worker typecheck",
    "typecheck:playwright": "tsc --noEmit --incremental --project playwright/tsconfig.json",
    "typecheck:test-helpers": "tsc --noEmit --incremental --project test-helpers/tsconfig.json",
    "typecheck:integration-tests": "tsc --noEmit --incremental --project integration-tests/tsconfig.json",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "oxlint:fix": "oxlint --type-aware --fix --deny-warnings",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "knip": "knip --treat-config-hints-as-errors",
    "knip:production-exports": "knip --production --include-entry-exports --exports --workspace '@voucha/backend' --workspace '@voucha/api' --workspace '@entrypoints/*' --workspace '@services/*' --workspace '@modules/*' --workspace '@data-stores/*' --workspace '@queues/*' --workspace '@workers/*' --workspace '@flows/*' --workspace '@agents/*' --treat-config-hints-as-errors",
    "syncpack:lint": "syncpack lint && syncpack format --check",
    "syncpack:fix": "syncpack fix && syncpack format",
    "repo-file-policy": "node static-code-analysis/run-node-checks.mts --checks repo-file-policy",
    "config-inventory-policy": "node static-code-analysis/run-node-checks.mts --checks config-inventory-policy",
    "dependency-license-policy": "node static-code-analysis/run-node-checks.mts --checks dependency-license-policy",
    "no-mistakes": "no-mistakes --timeout 60 --lock-timeout 55 check --tsconfig tsconfig.json",
    "dep-cruise": "pnpm run dep-cruise:backend && pnpm run dep-cruise:web && pnpm run dep-cruise:lambdas && pnpm run dep-cruise:scripts",
    "dep-cruise:backend": "depcruise --config backend/.dependency-cruiser.cjs --output-type err backend ts-shared",
    "dep-cruise:web": "depcruise --config web/.dependency-cruiser.cjs --output-type err web",
    "dep-cruise:lambdas": "depcruise --config lambdas/.dependency-cruiser.cjs --output-type err lambdas",
    "dep-cruise:scripts": "node static-code-analysis/run-tooling-dependency-cruiser.mts && depcruise --config .dependency-cruiser.cjs --output-type err --do-not-follow '^(?!playwright/tests/)' playwright/tests",
    "lint:links": "./ci/lint-links.sh",
    "clean:next": "rm -rf web/.next web/node_modules/.cache",
    "build:storybook": "pnpm --dir web run build-storybook",
    "dev:cloudflare-worker": "pnpm --dir cloudflare-worker run dev",
    "cloc": "node dev/cloc.mts",
    "verify:workflow-secrets": "node dev/verify-workflow-secrets.mts",
    "docs:agent-tools": "node backend/scripts/generate-agent-tools-doc.mts",
    "explain:seed": "bash -c 'source .env && node backend/scripts/explain-analyze/seed.mts'",
    "explain:run": "bash -c 'source .env && node backend/scripts/explain-analyze/run.mts'",
    "explain:analyze": "bash -c 'source .env && node backend/scripts/explain-analyze/analyze.mts'",
    "explain:dump": "node backend/scripts/explain-analyze/dump.mts",
    "login-as": "bash -c 'source .env && node backend/scripts/login-as/run.mts \"$@\"' --",
    "pr:attach-screenshots": "gh-pr-attach-screenshots",
    "seed-source": "bash -c 'source .env && node backend/scripts/seed-source/run.mts'",
    "prepare": "node backend/scripts/prepare-husky.mts"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@jongleberry/vurst-runtime": "^0.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "^2.51.2",
    "@storybook/addon-vitest": "^10.6.0",
    "@ts-shared/utils": "workspace:^",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@valkey/valkey-glide": "^2.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vouchington/localization": "0.2.0",
    "@vouchington/localization-compiler": "0.2.2",
    "agent-blackboard": "0.6.0",
    "csv-parse": "7.0.2",
    "dependency-cruiser": "^18.4.0",
    "eslint-plugin-no-mistakes": "^0.65.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-vouchington": "^0.0.3",
    "gh-pr-attach-screenshots": "0.2.0",
    "glide-mq": "^0.15.5",
    "husky": "^9.1.7",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "knip": "^6",
    "no-mistakes": "^0.65.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "oxlint-tsgolint": "7.0.2002",
    "p-settle": "5.2.1",
    "picomatch": "^4.0.4",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "pr-shepherd": "^0.52.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "squawk-cli": "2.64.0",
    "syncpack": "^15.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.1",
    "vouchington-tooling": "^0.19.1",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.13.1"
}
