# Server Configuration
export PORT=2999 # Backend API server port
export NEXT_PUBLIC_API_BASE_URL=http://localhost:2999 # Backend API URL for web frontend

# Optional: used for chat, moderation, agents, autotagging, and reranking
export OPENAI_API_KEY=
# Optional: AWS S3 credentials for local web-stack workers that write sitemaps, crawl HTML, and images.
# Service-specific values are preferred; shared AWS_* credentials are accepted as fallback.
export S3_AWS_ACCESS_KEY_ID=
export S3_AWS_SECRET_ACCESS_KEY=
export S3_AWS_SESSION_TOKEN=
# Amazon Bedrock Nova 2 Multimodal Embeddings V1 (us-east-1).
# Local-only explicit credentials; ECS uses OpenTofu-managed IAM task roles.
export BEDROCK_AWS_ACCESS_KEY_ID=
export BEDROCK_AWS_SECRET_ACCESS_KEY=
export BEDROCK_AWS_SESSION_TOKEN=
export BEDROCK_AWS_REGION=us-east-1
export BEDROCK_BATCH_ROLE_ARN=
# Facebook OAuth (server-side)
export FACEBOOK_APP_ID=
export FACEBOOK_APP_SECRET=
# Facebook OAuth (client-side, for web)
export NEXT_PUBLIC_FACEBOOK_APP_ID=
# Apple OAuth (server-side)
export APPLE_CLIENT_ID=
export APPLE_NATIVE_CLIENT_IDS=
export APPLE_TEAM_ID=
export APPLE_KEY_ID=
export APPLE_PRIVATE_KEY=
# Apple OAuth (client-side, for web)
export NEXT_PUBLIC_APPLE_CLIENT_ID=
# Apple App Attest (server-side)
export APPLE_APP_ATTEST_TEAM_ID=
export APPLE_APP_ATTEST_BUNDLE_ID=
# Apple App Store memberships. The server API credentials are worker-only in deployment.
export APPLE_APP_STORE_APPLICATION_ID=
export APPLE_APP_STORE_APP_ID=
export APPLE_APP_STORE_SERVER_API_ISSUER_ID=
export APPLE_APP_STORE_SERVER_API_KEY_ID=
export APPLE_APP_STORE_SERVER_API_PRIVATE_KEY=
# Google OAuth (server-side)
export GOOGLE_CLIENT_ID=
export GOOGLE_CLIENT_SECRET=
# Google OAuth (client-side, for web)
export NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# X (Twitter) OAuth (server-side)
export X_CLIENT_ID=
export X_CLIENT_SECRET=
# X (Twitter) OAuth (client-side, for web)
export NEXT_PUBLIC_X_CLIENT_ID=
# LinkedIn OAuth (server-side)
export LINKEDIN_CLIENT_ID=
export LINKEDIN_CLIENT_SECRET=
# LinkedIn OAuth (client-side, for web)
export NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
# Microsoft OAuth (server-side)
export MICROSOFT_CLIENT_ID=
export MICROSOFT_CLIENT_SECRET=
export MICROSOFT_TENANT_ID=
# Microsoft OAuth (client-side, for web)
export NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# Stripe
export STRIPE_SECRET_KEY=
export STRIPE_PUBLISHABLE_KEY=
# SES configuration sets isolate marketing bounce/complaint reputation from
# transactional (auth) email (`vouchington-infra` `opentofu/ses.tf`, #7113). Leave empty locally —
# no configuration set is applied, which is correct dev behavior.
export SES_CONFIGURATION_SET_TRANSACTIONAL=
export SES_CONFIGURATION_SET_MARKETING=
# CAN-SPAM postal-address footer for marketing/commercial email. Non-secret.
# Leave empty locally to fall back to the backend's placeholder constant.
export MARKETING_POSTAL_ADDRESS=
# Sitemap base URL for generating absolute URLs
export SITEMAP_BASE_URL=https://voucha.ai
# Native app browser callback origin. Defaults to SITEMAP_BASE_URL when unset.
export VOUCHA_WEB_BASE_URL=
# Set to 'true' for staging environments to prevent search engine indexing
export NEXT_PUBLIC_NOINDEX=
# App session/device JWT keys (base64-encoded JSON arrays of JWKs, newest first)
export VOUCHA_SESSION_JWT_PRIVATE_KEYS_B64=
export VOUCHA_SESSION_JWT_PUBLIC_KEYS_B64=
# Bluesky (AT Protocol) OAuth private_key_jwt signing key (base64-encoded JSON array of EC P-256
# JWKs). Leave unset in dev/test — backend/modules/bluesky-oauth falls back to a bundled test key.
export VOUCHA_BLUESKY_JWT_PRIVATE_KEYS_B64=
# Cloudflare Turnstile CAPTCHA — leave unset for normal dev/test to use Cloudflare's public
# always-pass test keys. Set both only for staging/production or explicit local opt-in.
# See https://developers.cloudflare.com/turnstile/.
export CLOUDFLARE_TURNSTILE_SECRET_KEY=
export NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# Google reCAPTCHA Enterprise — invisible score-based signal on post/comment creation, layered
# alongside Turnstile. Leave unset in dev/test (there is no score-based test key, so it is skipped
# fail-open). Set all four in staging/production, then enable via the admin business-config UI.
# The two site-key vars hold the same public value. See docs/overview/architecture/captcha.md.
export GOOGLE_RECAPTCHA_PROJECT_ID=
export GOOGLE_RECAPTCHA_API_KEY=
export GOOGLE_RECAPTCHA_SITE_KEY=
export NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=
# API key signing secret. ./dev/initialize web generates a local value; this fake value is only
# for ad hoc local shells that do not source .env.
# Local-only OpenTelemetry tracing. Unset by default — a complete no-op when not set.
# Run ./dev/otel-up to start the local collector + Jaeger stack, then set OTEL_ENABLED=1
# and restart services (./dev/tmux). See docs/development/opentelemetry.md.
# export OTEL_ENABLED=1
# export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# export OTEL_TRACES_SAMPLER=parentbased_always_on
export API_KEY_CHECKSUM_SECRET='this is a fake local API key checksum secret for development only'
# OTP token HMAC secret. ./dev/initialize web generates a local value; this fake value is only
# for ad hoc local shells that do not source .env.
export VOUCHA_OTP_TOKEN_HASH_SECRET='this is a fake local OTP HMAC secret for development only'
# Stored secret encryption keys. ./dev/initialize web generates a local value; this fake value is
# only for ad hoc local shells that do not source .env.
export VOUCHA_STORED_SECRET_ENCRYPTION_KEYS='fake-local-development-key:raw32:this fake test key is not secret'
