      "family": "moderation-appeal-lifecycle",
      "requiredConsumers": ["backend", "web", "swift", "dotnet"],
      "input": {
        "preconditions": {
          "status": "pending",
          "approvedAt": null,
          "sentAt": null,
          "viewerRole": "administrator"
