      },
      "expected": {
        "visibleState": { "status": "pending", "latestLifecycleChangeChanged": true },
        "availableActions": ["rerun", "approve"],
        "reconciliation": { "strategy": "server-response" },
        "cancellation": { "behavior": "not-applicable" }
      },
      "backendExpected": {
        "visibleState": { "status": "pending", "latestLifecycleChangeChanged": true },
        "availableActions": [],
        "reconciliation": { "strategy": "server-response" },
        "cancellation": { "behavior": "not-applicable" }
