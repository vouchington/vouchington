        {
          "tool": {
            "name": "compare_topics",
            "description": "Compare data point statistics side-by-side for two topics (cards, bank accounts, etc.). Useful for answering questions like \"which card has a better approval rate?\"",
            "inputSchema": {
              "type": "object",
              "properties": {
                "topic_id_a": {
                  "type": "string",
                  "description": "UUID of the first topic to compare"
                },
                "topic_id_b": {
                  "type": "string",
                  "description": "UUID of the second topic to compare"
                },
                "vertical": {
                  "type": "string",
                  "enum": ["credit_card", "bank_account"],
                  "description": "Optionally filter to a specific data point vertical"
                }
              },
              "required": ["topic_id_a", "topic_id_b"]
            },
            "annotations": {
              "readOnlyHint": true
            },
            "_meta": {
              "voucha/requiredScopes": ["topics:read"]
            }
          },
          "plan": "free",
          "roles": null,
          "api": [
            {
              "method": "GET",
              "path": "/api/v1/topics/compare"
            }
          ]
        },
