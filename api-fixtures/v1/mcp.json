                "direction": {
                  "type": "string",
                  "enum": ["parents", "children", "both"],
                  "description": "Which direction to traverse. \"parents\" = what this topic belongs to, \"children\" = what belongs to this topic, \"both\" = all relations. Defaults to \"both\"."
