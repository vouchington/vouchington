{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Production-only (`!`): helper files would otherwise be production entries whose imports hide
  // exports that only tests use.
  "ignoreWorkspaces": ["backend/test-helpers!"],
  "workspaces": {
    ".": {
      "entry": [
        "dev/codex-hooks/policy.mts",
        "dev/agent-policy.mts",
        "dev/agent-issue-labels/**/*.mts",
        "dev/otel-register.mts",
        "dev/launch-services.mts",
        "dev/sandbox-command-audit/rules.mts",
        "test-helpers/vitest.runner.backend-data-guards.mts",
      ],
      "project": [
        ".github/workflows/**/*.mts",
        "dev/**/*.mts",
        "test-helpers/**/*.mts",
        "test-helpers/**/*.ts",
      ],
      "ignoreBinaries": [
        "psql", // PostgreSQL system CLI probed by local DB-backed test setup checks
        "valkey-cli", // Valkey system CLI probed by local DB-backed test setup checks
        "wrangler", // GitHub Actions invokes the Cloudflare Worker workspace's pinned binary
        "gitleaks", // GitHub Actions runs the real scanner in gitleaks-scanner.test.mts
        "lychee", // Real Lychee matcher exercised by the CI tooling test suite
      ],
      // Hook modules are loaded by the harness outside the import graph.
      "includeEntryExports": false,
    },
    "static-code-analysis": {
      "entry": [
        "config-inventory/cli.mts",
        "docker-deploy/prune-deployed-runtime-deps.mts",
        "docker-deploy/prune-opentelemetry-alternate-builds.mts",
        "docker-deploy/restore-deployed-workspace-packages.mts",
      ],
      "project": ["**/*.mts"],
      "includeEntryExports": true,
    },
    "backend": {
      "entry": ["dev.mts"],
      "project": ["**/*.mts"],
    },
    "backend/md": {
      "entry": ["**/*.mts"],
    },
    "backend/api": {
      "entry": ["v1/**/*.mts"],
      "includeEntryExports": false,
      // Required by the new-service runtime package rule. Reconciliation runs in the entity
      // listener worker, so the API package does not have a direct static import for knip to see.
      "ignoreDependencies": [
        "@services/entity-listener-reconciliation",
        // Required package edges; classifier runs are consumed by the AI worker, not routes.
        "@services/classifier-runs",
        "@services/post-classifier",
      ],
    },
    "backend/entrypoints/worker-cpu": {
      "entry": ["**/*.mts"],
    },
    "backend/entrypoints/worker-io": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/worker-runtime": {
      "entry": ["**/*.mts"],
    },
    "backend/entrypoints/api": {
      "entry": ["**/*.mts"],
      // These packages are declared here for the API entrypoint's runtime package rule, but
      // are consumed by API routes or registered worker/service paths outside this workspace's
      // entry glob. The policy test requires each exact out-of-graph edge to have real evidence.
      "ignoreDependencies": [
        "@modules/bluesky-oauth",
        "@services/bluesky-accounts",
        "@services/bluesky-follows",
        "@services/classifier-runs",
        "@services/entity-listener-reconciliation",
        "@services/entity-relation-actions",
        // Required package edge; classifier execution is consumed by the AI worker, not routes.
        "@services/post-classifier",
      ],
    },
    "backend/config": {
      "entry": ["**/*.mts"],
    },
    "backend/test-helpers": {
      "entry": ["**/*.mts"],
    },
    "backend/types": {
      "entry": ["**/*.mts"],
    },
    "backend/scripts": {
      "entry": [
        "generate-mcp-catalog.mts",
        "explain-analyze/seed.mts",
        "explain-analyze/run.mts",
        "explain-analyze/analyze.mts",
        "explain-analyze/dump.mts",
        "prepare-husky.mts",
      ],
      "project": ["**/*.mts"],
      "includeEntryExports": true,
    },
    "backend/mcp": {
      "entry": ["**/*.mts"],
    },
    "backend/rss": {
      "entry": ["**/*.mts"],
    },
    "email-templates": {
      // The build emits runtime and declaration entrypoints for external consumers.
      "includeEntryExports": false,
    },
    "playwright": {
      "entry": [
        "global-setup.mts",
        "setup/**/*.setup.mts",
        "tests/**/*.spec.mts",
        "credentialed/**/*.spec.mts",
        "helpers/**/*.test.mts",
        // Compiler-only contracts are checked by playwright/tsconfig.json, never a runtime runner.
        "test-helpers/public-test-type-contract.mts",
        "test-helpers/public-test-negative-type-contract.mts",
        "../playwright.credentialed.config.mts",
        // Passed as a CLI path by dev/localization/local-smoke.mts, not imported.
        "localization-tmux.config.mts",
        // Loaded by the localization config through Playwright's string-valued globalSetup.
        "localization-timeout-setup.mts",
        // Started by the Playwright backend command strings, not imported.
        "test-helpers/launch-api.mts",
      ],
      "project": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/data-stores/psql": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
      "ignoreIssues": {
        "migrations/0000-00-00-0-finite-values.mts": ["exports"],
      },
    },
    "ci": {
      "entry": [
        "ci-local.mts",
        "setup-web-integration.mts",
        // Called by Actions or shell entrypoints rather than imported by another module.
        "validate-vitest-cli-timeouts.mts!",
        "write-coverage-scope.mts!",
        // Invoked from the backend image build action rather than imported by another module.
        "check-deployed-worker-native-addons.mjs!",
      ],
      "project": ["**/*.mts", "**/*.mjs"],
      "includeEntryExports": true,
      // The backend unit workflow executes ./ci/node_modules/.bin/coverage-check directly.
      "ignoreDependencies": ["coverage-check"],
    },
    "backend/data-stores/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/data-stores/graceful-shutdown": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/data-stores/valkey-pubsub": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/data-stores/valkey-rate-limiter": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/modules/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/modules/on-error": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/modules/pagination": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/modules/rss-feed-cover-art": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/modules/structured-decisions": {
      // Benchmark is a development CLI; keep manifest entries for production callers.
      "entry": ["benchmark.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/services/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/services/oauth-accounts": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-apple": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-facebook": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-github": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-google": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-linkedin": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-microsoft": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/oauth-x": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/posts": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/mcp-tools": {
      // Keep Knip's package.json-derived entry and default source/test project patterns so API
      // route imports reach authenticate/challenge internals in production analysis.
      "ignoreExportsUsedInFile": true,
    },
    "backend/services/api-keys": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/passkeys": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/totp": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/session-advisory-lock": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/identity-verification": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/user-consents": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/request-client-info": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/read-states": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/recently-viewed": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/aside-preferences": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/services/queue-monitoring": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/modules/worker-queue-inventory": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": false,
    },
    "backend/queues/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/workers/*": {
      "entry": ["**/*.mts"],
    },
    "backend/agents/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/agents/copyright-appeal-recommendation": {
      // Keep the package's manifest entry so production consumers reach its run module.
      "ignoreExportsUsedInFile": false,
    },
    "backend/agents/copyright-email-intake": {
      // Keep the package's manifest entry so production consumers reach its run module.
      "ignoreExportsUsedInFile": false,
    },
    "backend/agents/copyright-form-screening": {
      // Keep the package's manifest entry so production consumers reach its run module.
      "ignoreExportsUsedInFile": false,
    },
    "backend/agents/copyright-submission-guidance": {
      // Keep the package's manifest entry so production consumers reach its run module.
      "ignoreExportsUsedInFile": false,
    },
    "web": {
      "entry": [
        "public/service-worker.js!",
        // Loaded at runtime by service-worker.js through importScripts(), which knip cannot
        // follow as a static module edge.
        "public/service-worker-push.js!",
        // Vite and Vitest resolve these fixture modules through configured aliases.
        "storybook/mocks/contribute-cta-aside.tsx",
        "storybook/mocks/get-resolved-ui-locale.ts",
        "storybook/mocks/get-translations.ts",
        "storybook/mocks/languages.ts",
        "storybook/mocks/load-server-messages.ts",
        "storybook/mocks/upgrade-membership-aside.tsx",
        // Reached only via the `web-storybook-browser` Vitest project's `setupFiles` string
        // (test-helpers/vitest-config/storybook-browser-project.mts), never a static import;
        // same pattern as the root workspace's string-valued Vitest runner entry.
        "test-helpers/vitest.setup.fake-timer-guard.mts",
      ],
      // Next route exports and browser-loaded workers have external consumers.
      "includeEntryExports": false,
    },
    "cloudflare-worker": {
      // Wrangler and esbuild load the Worker export outside the static import graph.
      "includeEntryExports": false,
      // `cloudflare:workers` is a Workers-runtime built-in import protocol
      // (like `node:fs`), not the npm `cloudflare` API-client package; knip
      // strips the scheme and flags the bare specifier as unlisted.
      "ignoreDependencies": ["cloudflare"],
    },
    "ts-shared/*": {
      "entry": ["**/*.mts"],
    },
    "lambdas/image-resize": {
      // AWS invokes the bundled handler export outside the module graph.
      "includeEntryExports": false,
      // @fontsource/inter is read at runtime via createRequire().resolve(), which knip's
      // static import analysis can't follow. @types/react is a devDependency purely so
      // satori's public .d.ts (which types its element param as React's ReactNode) resolves;
      // no source file imports 'react' directly.
      "ignoreDependencies": ["@fontsource/inter", "@types/react"],
    },
  },
}
