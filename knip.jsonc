{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Production-only (`!`): helper files would otherwise be production entries whose imports hide
  // exports that only tests use.
  "ignoreWorkspaces": ["backend/test-helpers!"],
  "workspaces": {
    ".": {
      "entry": [
        "dev/codex-hooks/pre-tool-use.mts",
        "dev/codex-hooks/persist-session-id.mts",
        "dev/codex-hooks/post-tool-use.mts",
        "dev/codex-hooks/post-tool-use-command.mts",
        "dev/pr-description.mts",
        "dev/agent-issue-labels/**/*.mts",
        "dev/otel-register.mts",
        "test-helpers/glide-mq-vitest-shim.mts",
        // The disposable database case helper passes this config by CLI path to a child Vitest.
        "test-helpers/vitest.config.isolated-database-case.mts",
        // Reached only through backend-data-stores' string-valued Vitest `runner` config.
        "test-helpers/vitest.runner.glide-mq-worker-attachment-guard.mts",
      ],
      "project": [
        ".github/workflows/**/*.mts",
        "dev/**/*.mts",
        "test-helpers/**/*.mts",
        "test-helpers/**/*.ts",
      ],
      "ignoreBinaries": [
        "psql", // PostgreSQL system CLI probed by local DB-backed test setup checks
        "valkey-cli", // Valkey system CLI probed by local DB-backed test setup checks
        "wrangler", // GitHub Actions invokes the Cloudflare Worker workspace's pinned binary
        "gitleaks", // GitHub Actions runs the real scanner in gitleaks-scanner.test.mts
        "lychee", // Real Lychee matcher exercised by the CI tooling test suite
      ],
      "ignoreExportsUsedInFile": true,
    },
    "static-code-analysis": {
      "entry": ["**/*.mts"],
      "project": ["**/*.mts"],
    },
    "backend": {
      "entry": ["dev.mts"],
      "project": ["**/*.mts"],
    },
    "backend/md": {
      "entry": ["**/*.mts"],
    },
    "backend/api": {
      "entry": ["v1/**/*.mts"],
      "includeEntryExports": false,
      // Required by the new-service runtime packaging rule. Reconciliation runs in the entity
      // listener worker, so the API package does not have a direct static import for knip to see.
      "ignoreDependencies": [
        "@services/entity-listener-reconciliation",
        // Required packaging edges; classifier runs are consumed by the AI worker, not routes.
        "@services/classifier-runs",
        "@services/post-classifier",
      ],
    },
    "backend/entrypoints/worker-cpu": {
      "entry": ["**/*.mts"],
    },
    "backend/entrypoints/worker-io": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/worker-runtime": {
      "entry": ["**/*.mts"],
    },
    "backend/entrypoints/api": {
      "entry": ["**/*.mts"],
      // These packages are declared here for the API entrypoint's runtime packaging rule, but
      // are consumed by API routes or registered worker/service paths outside this workspace's
      // entry glob. The policy test requires each exact out-of-graph edge to have real evidence.
      "ignoreDependencies": [
        "@modules/bluesky-oauth",
        "@services/bluesky-accounts",
        "@services/bluesky-follows",
        "@services/classifier-runs",
        "@services/entity-listener-reconciliation",
        "@services/entity-relation-actions",
        // Required packaging edge; classifier execution is consumed by the AI worker, not routes.
        "@services/post-classifier",
      ],
    },
    "backend/config": {
      "entry": ["**/*.mts"],
    },
    "backend/test-helpers": {
      "entry": ["**/*.mts"],
    },
    "backend/types": {
      "entry": ["**/*.mts"],
    },
    "backend/scripts": {
      "entry": ["**/*.mts"],
    },
    "backend/tools": {
      "entry": ["**/*.mts"],
    },
    "backend/rss": {
      "entry": ["**/*.mts"],
    },
    "email-templates": {
      "entry": ["**/*.tsx", "**/*.mts"],
    },
    "playwright": {
      "entry": [
        "global-setup.mts",
        "setup/**/*.setup.mts",
        "tests/**/*.spec.mts",
        "credentialed/**/*.spec.mts",
        "helpers/**/*.test.mts",
        "../playwright.credentialed.config.mts",
        // Passed as a CLI path by dev/localization/local-smoke.mts, not imported.
        "localization-tmux.config.mts",
      ],
      "project": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/data-stores/psql": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "ci": {
      "entry": ["**/*.mts"],
      "project": ["**/*.mts"],
    },
    "backend/data-stores/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/modules/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/services/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/services/mcp-tools": {
      // Keep Knip's package.json-derived entry and default source/test project patterns so API
      // route imports reach authenticate/challenge internals in production analysis.
      "ignoreExportsUsedInFile": true,
    },
    "backend/queues/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "backend/workers/*": {
      "entry": ["**/*.mts"],
    },
    "backend/agents/*": {
      "entry": ["**/*.mts"],
      "ignoreExportsUsedInFile": true,
    },
    "web": {
      "entry": [
        "lib/api/**/*.ts",
        "types/api-responses.ts",
        "storybook/mocks/**/*.{ts,tsx}",
        "public/service-worker.js",
        // Loaded at runtime by service-worker.js through importScripts(), which knip cannot
        // follow as a static module edge.
        "public/service-worker-push.js",
        // Reached only via the `web-storybook-browser` Vitest project's `setupFiles` string
        // (test-helpers/vitest-config/storybook-browser-project.mts), never a static import;
        // same pattern as the root workspace's `test-helpers/glide-mq-vitest-shim.mts` entry.
        "test-helpers/vitest.setup.fake-timer-guard.mts",
        // Same pattern: redirect shim for web-storybook-browser's own project-level `setupFiles`
        // literal (root: 'web' resolves it here); no-mistakes resolves the same literal relative
        // to the repo root instead, landing on test-helpers/vitest.setup.storybook-browser-guard.mts.
        "test-helpers/vitest.setup.storybook-browser-guard.mts",
      ],
      "ignoreExportsUsedInFile": true,
    },
    "cloudflare-worker": {
      "entry": ["**/*.mts"],
      // `cloudflare:workers` is a Workers-runtime built-in import protocol
      // (like `node:fs`), not the npm `cloudflare` API-client package; knip
      // strips the scheme and flags the bare specifier as unlisted.
      "ignoreDependencies": ["cloudflare"],
    },
    "ts-shared/*": {
      "entry": ["**/*.mts"],
    },
    "lambdas/image-resize": {
      "entry": ["**/*.mts"],
      // @fontsource/inter is read at runtime via createRequire().resolve(), which knip's
      // static import analysis can't follow. @types/react is a devDependency purely so
      // satori's public .d.ts (which types its element param as React's ReactNode) resolves;
      // no source file imports 'react' directly.
      "ignoreDependencies": ["@fontsource/inter", "@types/react"],
    },
  },
}
