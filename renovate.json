{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "enabledManagers": ["nvm", "custom.regex"],
  "automerge": false,
  "labels": ["dependencies", "renovate"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 8,
  "packageRules": [
    {
      "description": "Propose dependency mirror digest updates as reviewable PRs whenever Renovate runs",
      "matchFileNames": ["ci/dependency-mirror/images.json"],
      "matchManagers": ["custom.regex"],
      "schedule": ["at any time"],
      "groupName": "CI dependency mirror digests"
    },
    {
      "description": "Propose verified GHCR consumer digests after mirror publication",
      "matchFileNames": [
        ".github/**",
        "backend/Dockerfile",
        "web/Dockerfile",
        "dev/initialize",
        "dev/otel/compose.yaml"
      ],
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/vouchington/dependency-*"],
      "schedule": ["at any time"],
      "groupName": "CI dependency consumer digests"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Reviewed upstream image indexes copied to GHCR",
      "managerFilePatterns": ["ci/dependency-mirror/images.json"],
      "matchStrings": [
        "\"source\": \"(?<depName>(?:docker\\.io/[^\"]+|gcr\\.io/distroless/nodejs26-debian13))\",\\s*\"tag\": \"(?<currentValue>[^\"]+)\",\\s*\"digest\": \"(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Dockerfile frontend copied to reviewed GHCR dependency package",
      "managerFilePatterns": ["backend/Dockerfile", "web/Dockerfile"],
      "matchStrings": [
        "# syntax=(?<depName>ghcr\\.io/vouchington/dependency-dockerfile):(?<currentValue>[A-Za-z0-9_.-]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Secondary Alpine Node stage in the web Dockerfile",
      "managerFilePatterns": ["web/Dockerfile"],
      "matchStrings": [
        "FROM\\s+(?<depName>ghcr\\.io/vouchington/dependency-node):(?<currentValue>[0-9]+-alpine)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Workflow env vars annotated with `# renovate: datasource=… depName=…`",
      "managerFilePatterns": [".github/workflows/*.yml", ".github/actions/*/action.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: versioning=(?<versioning>[a-z-]+))?\\s*\\n\\s*[A-Za-z_][A-Za-z0-9_]*:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ]
    },
    {
      "customType": "regex",
      "description": "NVM install URL in dev/initialize",
      "managerFilePatterns": ["dev/initialize"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n[^\\n]*nvm-sh/nvm/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/install\\.sh"
      ]
    },
    {
      "customType": "regex",
      "description": "Dockerfile ARG annotated with `# renovate: datasource=… depName=…`",
      "managerFilePatterns": ["**/Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: versioning=(?<versioning>[a-z-]+))?\\s*\\nARG\\s+[A-Z_][A-Z0-9_]*=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": ".mise.toml tool versions annotated with `# renovate: datasource=… depName=…`",
      "managerFilePatterns": [".mise.toml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: versioning=(?<versioning>[a-z-]+))?\\s*\\n\\s*\"?[A-Za-z0-9_:/.-]+\"?\\s*=\\s*['\"](?<currentValue>[^'\"\\s]+)['\"]"
      ]
    },
    {
      "customType": "regex",
      "description": "Reviewed GHCR dependency images used by CI and local tools",
      "managerFilePatterns": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        ".github/actions/*/action.yml",
        "dev/initialize",
        "dev/otel/compose.yaml"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/vouchington/dependency-(?:pgvector|valkey|buildkit|otel)):(?<currentValue>[A-Za-z0-9_.-]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
