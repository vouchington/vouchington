#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"

STACK=false
UPSTACK=false

usage() {
  cat <<'EOF'
Usage: ./dev/rebase-onto-main [--stack] [--upstack]

Fetches origin/main, then rebases onto it. With --stack, runs gh stack rebase
instead (add --upstack to rewrite upper stack layers). A stack with only one
unmerged layer left is a plain branch, so --stack rebases it onto origin/main.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --stack)
      STACK=true
      ;;
    --upstack)
      UPSTACK=true
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if $UPSTACK && ! $STACK; then
  echo "Error: --upstack requires --stack" >&2
  usage >&2
  exit 2
fi

git -C "$REPO_ROOT" fetch origin main

open_stack_layers() {
  gh stack view --json 2>/dev/null | node -e '
    let input = ""
    process.stdin.on("data", chunk => (input += chunk))
    process.stdin.on("end", () => {
      const { branches } = JSON.parse(input)
      console.log(branches.filter(branch => !branch.isMerged).length)
    })
  ' 2>/dev/null || echo unknown
}

# gh stack rebase can replay merged trunk commits once the lower layers land (#4410).
if $STACK && [ "$(open_stack_layers)" = 1 ]; then
  echo "Only one open stack layer remains; rebasing onto origin/main." >&2
  STACK=false
fi

if $STACK; then
  if $UPSTACK; then
    gh stack rebase --upstack
  else
    gh stack rebase
  fi
else
  git -C "$REPO_ROOT" rebase origin/main
fi
