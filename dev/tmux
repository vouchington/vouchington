#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() { echo "Usage: ./dev/tmux [--no-attach] [-v|--verbose]"; }
if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then usage; exit 0; fi

# Parse --verbose / -v and --no-attach flags. Default to error-only log output.
LOG_LEVEL=error
NO_ATTACH=false
VERBOSE_SET=false
for arg in "$@"; do
  case "$arg" in
    --verbose|-v)
      if $VERBOSE_SET; then echo "Error: duplicate option: $arg" >&2; usage >&2; exit 2; fi
      VERBOSE_SET=true
      LOG_LEVEL=info
      ;;
    --no-attach)
      if $NO_ATTACH; then echo "Error: duplicate option: $arg" >&2; usage >&2; exit 2; fi
      NO_ATTACH=true
      ;;
    *) echo "Error: unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

if ! command -v tmux &>/dev/null; then
    echo "Error: tmux is not installed."
    echo "Provision the host with https://github.com/vouchington/vouchington-machines"
    echo "Required capabilities: docs/development/system-dependencies.md"
    exit 1
fi

if [ -n "${TMUX:-}" ] && [ "$NO_ATTACH" = "false" ]; then
    echo "Error: ./dev/tmux must be run outside tmux. Pass --no-attach to start services without attaching (for agents and scripts)."
    exit 1
fi

# The package-backed helper exists after initialization installs dependencies.
if [ ! -f "$REPO_ROOT/.env" ] || [ ! -f "$REPO_ROOT/.initialized" ] || [ "$(tr -d '[:space:]' < "$REPO_ROOT/.initialized")" != "web" ]; then
    echo "Error: web initialization not found. Run ./dev/initialize web first."
    exit 1
fi

# shellcheck source=lib/git-worktrees.sh
source "$REPO_ROOT/dev/lib/git-worktrees.sh"

set -a
source "$REPO_ROOT/.env"
set +a

SESSION="voucha-$(git_worktree_canonical_path_hash "$REPO_ROOT")"
MANAGED_WINDOWS=(nextjs backend worker cloudflare lambdas)

# Restore Valkey before reusing a running session, including after Docker restarts.
if [ -n "${VALKEY_CONTAINER:-}" ]; then
    if ! docker ps --format '{{.Names}}' | grep -qx "$VALKEY_CONTAINER"; then
        echo "Starting Valkey container..."
        docker start "$VALKEY_CONTAINER" >/dev/null 2>&1 || {
            if ! docker ps --format '{{.Names}}' | grep -qx "$VALKEY_CONTAINER"; then
                echo "Error: Failed to start Valkey container $VALKEY_CONTAINER."
                echo "Run ./dev/initialize web to recreate it."
                exit 1
            fi
        }
    fi
fi

quote_shell_arg() {
  local value="$1"
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

bash_lc_command() {
  local body="$1"
  local quoted_body
  quoted_body="$(quote_shell_arg "$body")"
  printf 'bash -lc %s' "$quoted_body"
}

window_cwd() {
  case "$1" in
    nextjs) printf '%s\n' "$REPO_ROOT/web" ;;
    cloudflare) printf '%s\n' "$REPO_ROOT/cloudflare-worker" ;;
    *) printf '%s\n' "$REPO_ROOT" ;;
  esac
}

window_exists() {
  local window="$1"
  local names
  names="$(tmux list-windows -t "=$SESSION" -F '#{window_name}' 2>/dev/null || true)"
  case $'\n'"$names"$'\n' in
    *$'\n'"$window"$'\n'*) return 0 ;;
    *) return 1 ;;
  esac
}

window_is_live() {
  local window="$1"
  local pane_pid
  if ! window_exists "$window"; then
    return 1
  fi
  while IFS= read -r pane_pid; do
    case "$pane_pid" in
      ''|*[!0-9]*) continue ;;
    esac
    if pgrep -P "$pane_pid" . >/dev/null 2>&1; then
      return 0
    fi
  done < <(tmux list-panes -t "=$SESSION:$window" -F '#{pane_pid}' 2>/dev/null || true)
  return 1
}

prepare_service_commands() {
  local need_catalog="$1"
  WORKER_PORT="${WORKER_PORT:?WORKER_PORT not set — run ./dev/initialize web first}"
  IMAGE_LAMBDA_PORT="${IMAGE_LAMBDA_PORT:?IMAGE_LAMBDA_PORT not set — run ./dev/initialize web first}"
  BACKEND_PORT="${PORT:?PORT not set — run ./dev/initialize web first}"
  NEXT_PORT="${NEXT_PORT:?NEXT_PORT not set — run ./dev/initialize web first}"

  HAS_CERTS=false
  if [ -f "$REPO_ROOT/dev/certs/localhost.pem" ] && [ -f "$REPO_ROOT/dev/certs/localhost-key.pem" ]; then
    HAS_CERTS=true
  fi

  OTEL_NODE_IMPORT=""
  if [ "${OTEL_ENABLED:-}" = "1" ]; then
    OTEL_NODE_IMPORT="--import \"$REPO_ROOT/dev/otel-register.mts\""
  fi

  NODE_OPTIONS_INIT='case " ${NODE_OPTIONS:-} " in *" --disable-warning=DEP0205 "*) ;; *) export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--disable-warning=DEP0205" ;; esac'
  WORKER_NODE_OPTIONS_INIT='case " ${NODE_OPTIONS:-} " in *" --max-old-space-size="*) ;; *) export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=3072" ;; esac'
  WRANGLER_LOG_LEVEL="$LOG_LEVEL"

  if [ "$need_catalog" = 1 ]; then
    LOCALIZATION_SQLITE_PATH="$(node --experimental-strip-types "$REPO_ROOT/dev/localization/local-catalog.mts")"
    WORKER_QUEUE_POLICY_CLI="$REPO_ROOT/backend/modules/worker-queue-inventory/worker-queue-policy-cli.mts"
    WORKER_QUEUES="$(node "$WORKER_QUEUE_POLICY_CLI" dev-all-queues)"
    BODY_BACKEND="source \"$REPO_ROOT/.env\"; $NODE_OPTIONS_INIT; LOCALIZATION_SQLITE_PATH=$(quote_shell_arg "$LOCALIZATION_SQLITE_PATH") OTEL_SERVICE_NAME=voucha-api LOG_LEVEL=$LOG_LEVEL node $OTEL_NODE_IMPORT --watch \"$REPO_ROOT/backend/entrypoints/api/serve.mts\"; read"
    BODY_WORKER="source \"$REPO_ROOT/.env\"; $NODE_OPTIONS_INIT; $WORKER_NODE_OPTIONS_INIT; LOCALIZATION_SQLITE_PATH=$(quote_shell_arg "$LOCALIZATION_SQLITE_PATH") OTEL_SERVICE_NAME=voucha-worker-cpu LOG_LEVEL=$LOG_LEVEL QUEUES=$WORKER_QUEUES UV_THREADPOOL_SIZE=\${UV_THREADPOOL_SIZE:-8} node $OTEL_NODE_IMPORT --watch \"$REPO_ROOT/backend/entrypoints/worker-cpu/serve.mts\"; read"
    CMD_BACKEND="$(bash_lc_command "$BODY_BACKEND")"
    CMD_WORKER="$(bash_lc_command "$BODY_WORKER")"
  fi

  BODY_NEXTJS="source \"$REPO_ROOT/.env\"; $NODE_OPTIONS_INIT; cd \"$REPO_ROOT/web\" && pnpm run dev; read"
  BODY_LAMBDAS="source \"$REPO_ROOT/.env\"; $NODE_OPTIONS_INIT; LOG_LEVEL=$LOG_LEVEL node --watch \"$REPO_ROOT/lambdas/dev-server.mts\"; read"
  CMD_NEXTJS="$(bash_lc_command "$BODY_NEXTJS")"
  CMD_LAMBDAS="IMAGE_LAMBDA_PORT=$(quote_shell_arg "$IMAGE_LAMBDA_PORT") $(bash_lc_command "$BODY_LAMBDAS")"
  if $HAS_CERTS; then
    BODY_CF_WORKER="source \"$REPO_ROOT/.env\"; $NODE_OPTIONS_INIT; cd \"$REPO_ROOT/cloudflare-worker\" && node scripts/wrangler/dev.mts --local --port \"$WORKER_PORT\" --ip 127.0.0.1 --local-protocol https --https-cert-path ../dev/certs/localhost.pem --https-key-path ../dev/certs/localhost-key.pem --log-level=$WRANGLER_LOG_LEVEL; read"
  else
    BODY_CF_WORKER="source \"$REPO_ROOT/.env\"; $NODE_OPTIONS_INIT; cd \"$REPO_ROOT/cloudflare-worker\" && node scripts/wrangler/dev.mts --local --port \"$WORKER_PORT\" --ip 127.0.0.1 --log-level=$WRANGLER_LOG_LEVEL; read"
  fi
  CMD_CF_WORKER="$(bash_lc_command "$BODY_CF_WORKER")"
}

window_command() {
  case "$1" in
    nextjs) printf '%s' "$CMD_NEXTJS" ;;
    backend) printf '%s' "$CMD_BACKEND" ;;
    worker) printf '%s' "$CMD_WORKER" ;;
    cloudflare) printf '%s' "$CMD_CF_WORKER" ;;
    lambdas) printf '%s' "$CMD_LAMBDAS" ;;
    *) return 1 ;;
  esac
}

decorate_window() {
  local name="$1"
  tmux select-pane -T "$name" -t "=$SESSION:$name"
  tmux set-option -w -t "=$SESSION:$name" pane-border-status top
}

restore_dead_managed_windows() {
  local dead=()
  local window
  local need_catalog=0
  for window in "${MANAGED_WINDOWS[@]}"; do
    if ! window_is_live "$window"; then
      dead+=("$window")
      case "$window" in
        backend|worker) need_catalog=1 ;;
      esac
    fi
  done
  if [ "${#dead[@]}" -eq 0 ]; then
    return 0
  fi
  prepare_service_commands "$need_catalog"
  for window in "${dead[@]}"; do
    if window_exists "$window"; then
      tmux respawn-pane -k -t "=$SESSION:$window.0" -c "$(window_cwd "$window")" "$(window_command "$window")" || return 1
    else
      tmux new-window -t "=$SESSION" -n "$window" -c "$(window_cwd "$window")" "$(window_command "$window")" || return 1
    fi
    decorate_window "$window" || return 1
  done
  return 0
}

finish_existing_session() {
  if [ "$NO_ATTACH" = "true" ]; then
    echo "Services already running in tmux session '$SESSION'."
    return 0
  fi
  echo "Reattaching to existing tmux session '$SESSION'..."
  tmux attach -t "=$SESSION"
}

reuse_existing_session() {
  local allow_restore="${1:-1}"
  local already_ready=false
  local attempt
  local ready
  ready="$(tmux show-options -qv -t "=$SESSION:" @voucha-ready 2>/dev/null || true)"
  if [ "$ready" = 1 ]; then
    already_ready=true
  else
    for ((attempt = 0; attempt < 99; attempt++)); do
      if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
        echo "Error: tmux session '$SESSION' disappeared during startup." >&2
        return 1
      fi
      sleep 0.1
      ready="$(tmux show-options -qv -t "=$SESSION:" @voucha-ready 2>/dev/null || true)"
      if [ "$ready" = 1 ]; then
        break
      fi
    done
    if [ "$ready" != 1 ]; then
      echo "Error: tmux session '$SESSION' did not finish startup." >&2
      return 1
    fi
  fi

  if $already_ready && [ "$allow_restore" = 1 ]; then
    if ! restore_dead_managed_windows; then
      echo "Error: failed to restore managed tmux windows; recreating session." >&2
      tmux kill-session -t "=$SESSION" 2>/dev/null || true
      return 2
    fi
  fi
  finish_existing_session
}

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  reuse_status=0
  reuse_existing_session || reuse_status=$?
  if [ "$reuse_status" -eq 0 ]; then
    exit 0
  fi
  if [ "$reuse_status" -ne 2 ]; then
    exit "$reuse_status"
  fi
fi

prepare_service_commands 1

if $HAS_CERTS; then
    echo "Entry point (HTTPS):     https://localhost:${WORKER_PORT}"
else
    echo "Entry point (HTTP):      http://localhost:${WORKER_PORT}"
fi
echo "Backend API:             http://localhost:${BACKEND_PORT}"
echo "Backend Workers:         (window 'worker' — all policy-managed queues)"
echo "Lambdas (image resize):  http://localhost:${IMAGE_LAMBDA_PORT}"
echo "Next.js:                 http://localhost:${NEXT_PORT}"
if [ "${OTEL_ENABLED:-}" = "1" ]; then
    echo "OpenTelemetry:           ENABLED — exporting to ${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4318} (run ./dev/otel-up first)"
fi
echo ""

# Layout: one pane per window, in this order:
#   1. nextjs
#   2. backend
#   3. worker
#   4. cloudflare
#   5. lambdas

# Create a new session outside tmux.
# The launcher owns cleanup only if tmux recorded its PID at session creation.
# Install traps before creation so a signal during new-session cannot strand it.
cleanup_partial_session() {
    if [ "$(tmux show-environment -t "=$SESSION" VOUCHA_LAUNCHER_PID 2>/dev/null || true)" = "VOUCHA_LAUNCHER_PID=$$" ]; then
        tmux kill-session -t "=$SESSION" 2>/dev/null || true
    fi
}
trap cleanup_partial_session EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if ! tmux new-session -d -s "$SESSION" -e "VOUCHA_LAUNCHER_PID=$$" -n "nextjs" -c "$REPO_ROOT/web" "$CMD_NEXTJS"; then
    trap - EXIT INT TERM
    if tmux has-session -t "=$SESSION" 2>/dev/null; then
        reuse_existing_session 0
        exit $?
    fi
    echo "Error: failed to create tmux session '$SESSION'." >&2
    exit 1
fi
decorate_window nextjs

tmux new-window -t "=$SESSION" -n "backend" -c "$REPO_ROOT" "$CMD_BACKEND"
decorate_window backend

tmux new-window -t "=$SESSION" -n "worker" -c "$REPO_ROOT" "$CMD_WORKER"
decorate_window worker

tmux new-window -t "=$SESSION" -n "cloudflare" -c "$REPO_ROOT/cloudflare-worker" "$CMD_CF_WORKER"
decorate_window cloudflare

tmux new-window -t "=$SESSION" -n "lambdas" -c "$REPO_ROOT" "$CMD_LAMBDAS"
decorate_window lambdas

tmux select-window -t "=$SESSION:nextjs"
tmux set-option -t "=$SESSION:" @voucha-ready 1
trap - EXIT INT TERM

if [ "$NO_ATTACH" = "true" ]; then
    echo "Services started in tmux session '$SESSION'."
    echo "To attach: tmux attach -t '$SESSION'"
else
    echo "Attaching to tmux session '$SESSION'..."
    tmux attach -t "=$SESSION"
fi
