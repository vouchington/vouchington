#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

FORCE=false

usage() {
    cat <<'USAGE'
Usage: ./dev/reset-worktree [--force]

Resets a worktree to a clean state for the next agent task:
  - Fetches origin/main
  - Tears down only DB + Valkey + services proven to belong to this worktree
    (preserves .env so port reuse works)
  - Creates a new random branch, then hard-resets it to origin/main
  - Removes worktree-local generated build and test output
  - Runs ./dev/initialize monorepo so pnpm exec tools work immediately
  - Clears the tmux window and pane title (if running inside tmux)

Refuses if there are uncommitted or untracked changes; use --force to
discard them. Run ./dev/initialize backend afterwards for DB/Valkey-backed
tests, or ./dev/initialize web when the full stack is needed.

Refuses to run on the main worktree (FORCE_MAIN_RESET=1 to override).
Full clones under .grok/worktrees or $TMPDIR do not need the override.
USAGE
}

for arg in "$@"; do
    case "$arg" in
        --force|-f)
            if $FORCE; then echo "Error: duplicate option: $arg" >&2; usage >&2; exit 2; fi
            FORCE=true
            ;;
        --help|-h)
            if [ "$#" -eq 1 ]; then usage; exit 0; fi
            echo -e "${RED}Error: help cannot be combined with other arguments${NC}" >&2
            usage >&2
            exit 2
            ;;
        *)
            echo -e "${RED}Error: unknown option: $arg${NC}" >&2
            usage >&2
            exit 2
            ;;
    esac
done

# shellcheck source=lib/refuse-on-main.sh
source "$REPO_ROOT/dev/lib/refuse-on-main.sh"
refuse_on_main "./dev/reset-worktree" "$REPO_ROOT"

reset_script="$REPO_ROOT/node_modules/vouchington-tooling/scripts/worktree/reset-worktree.sh"
if [ ! -x "$reset_script" ]; then
    echo "Error: worktree tooling is not installed. Run ./dev/initialize monorepo first." >&2
    exit 1
fi

# Explicit package build outputs and local test reports. Keep dependencies,
# configuration, credentials, infrastructure state, and service resources.
generated_paths=(
    dist
    output
    storybook-static
    web/.next
    web/storybook-static
    cloudflare-worker/.wrangler
    cloudflare-worker/dist
    email-templates/dist
    lambdas/image-resize/dist
    coverage
    coverage-affected
    coverage-changed
    coverage-full
    coverage-html
    coverage-artifacts
    playwright-report
    test-results
    .playwright-snapshots
    playwright/screenshots
    test-report.junit.xml
)

reset_args=(
    --root "$REPO_ROOT"
    --base-ref origin/main
    --pre "bash dev/lib/reset-worktree-hooks.sh pre"
    --post "bash dev/lib/reset-worktree-hooks.sh post"
)
if $FORCE; then reset_args+=(--force); fi
for generated_path in "${generated_paths[@]}"; do reset_args+=(--cache "$generated_path"); done

echo -e "${BLUE}=== Reset Worktree ===${NC}\n"
"$reset_script" "${reset_args[@]}"

new_branch=$(git -C "$REPO_ROOT" branch --show-current)
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✓ Worktree reset complete${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "${BLUE}Branch:${NC}   $new_branch (off origin/main)"
echo -e "${BLUE}Worktree:${NC} $(basename "$REPO_ROOT")"
echo ""
echo -e "${BLUE}Notes for the next agent:${NC}"
echo "  This worktree is a monorepo-initialized clean slate."
echo "  pnpm exec tools are ready. The previous branch still exists"
echo "  locally — the human can recover it with git checkout or git reflog."
echo ""
echo "  Run ./dev/initialize backend for DB/Valkey-backed tests, or"
echo "  ./dev/initialize web only when the full stack is needed."
echo "  .env is preserved so backend/web re-init reuses the same ports."
echo "  Pick a meaningful branch name when starting new work; rename off"
echo "  '$new_branch' immediately."
echo ""
