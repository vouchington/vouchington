#!/usr/bin/env bash
set -euo pipefail

# Remind the agent to rename the tmux window at workflow checkpoints.
# Called by Claude Code and Codex hooks; stdout is injected as context.
#
# Usage: dev/tmux-agent-reminder <event>
#   event: session-start | user-prompt
#
# post-tool moved to dev/tmux-reminder-post-tool.mts's renderPostToolReminder, called in-process
# from the merged dev/codex-hooks/post-tool-use-command.mts entrypoint — see
# dev/reference-agent-session-hooks.md.
#
# Silently exits 0 when not inside tmux.

EVENT="${1:-}"

if [ -z "${TMUX_PANE:-}" ]; then
  exit 0
fi

# Every event pipes the hook payload on stdin, even though none of the remaining cases need its
# contents (post-tool used to) — drain it so the caller never blocks on an unread pipe.
cat >/dev/null

pane_title() {
  tmux display-message -p -t "$TMUX_PANE" '#{pane_title}' 2>/dev/null || true
}

POLICY="Run: ./dev/tmux-name <name>  (must run unsandboxed: Claude/Codex dangerouslyDisableSandbox; Cursor disable sandbox)
Checkpoints: (1) topic clear → short-hyphenated-name; (2) plan accepted → refine if scope shifted; (3) PR created → append -pr<N> suffix; (4) git push on PR branch → confirm -pr<N> still set; (5) after compaction → verify name still matches topic; (6) reset-worktree → confirm pane title is empty."

# Emit structured hook context for events that require JSON stdout.
emit_json() {
  local event="$1" msg="$2"
  jq -n --arg e "$event" --arg m "$msg" \
    '{"hookSpecificOutput":{"hookEventName":$e,"additionalContext":$m}}'
}

case "$EVENT" in

  session-start)
    emit_json "SessionStart" "[tmux-window-name] $POLICY"
    ;;

  user-prompt)
    TITLE="$(pane_title)"
    if [ -z "$TITLE" ] || printf '%s' "$TITLE" | grep -qE '^(claude|codex|grok|cursor|agent|zsh|bash|fish|reset|sh)$'; then
      printf '[tmux-window-name] Topic is clear — set the window name now. %s\n' "$POLICY"
    fi
    ;;

esac
