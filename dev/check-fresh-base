#!/usr/bin/env bash
set -euo pipefail

# SessionStart hook (Claude Code + Codex): wraps `vouchington fresh-base`, which owns the
# fetch and the ahead/behind/dirty classification, and adds Voucha's planning guidance.
# stdout is injected as context. Silent when the clean worktree matches origin/main, during
# compaction, or outside a git repository.
#
# Environment:
#   CHECK_FRESH_BASE_SKIP_FETCH=1  Skip the git fetch (for offline tests).

if [ -t 0 ]; then
  PAYLOAD="{}"
else
  PAYLOAD="$(cat)"
fi

# Mid-session compaction restarts are not new tasks.
SOURCE="$(printf '%s' "$PAYLOAD" | jq -r '.source // empty' 2>/dev/null || true)"
if [ "$SOURCE" = "compact" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  exit 0
fi
CLI="$(dirname "${BASH_SOURCE[0]}")/../node_modules/.bin/vouchington"

ARGS=(fresh-base)
if [ -n "${CHECK_FRESH_BASE_SKIP_FETCH:-}" ]; then
  ARGS+=(--skip-fetch)
fi
REPORT="$("$CLI" "${ARGS[@]}" 2>/dev/null || true)"
if [ -z "$REPORT" ]; then
  # A missing or failing CLI (for example before `pnpm install`) must not read as a clean worktree.
  jq -n '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"⚠️  Worktree base check: `vouchington fresh-base` is unavailable (run `pnpm install`), so freshness is unknown. Retry `git fetch origin` and compare with `origin/main` before relying on the current checkout."}}'
  exit 0
fi
if [ "$(printf '%s' "$REPORT" | jq -r '.needsAttention')" != "true" ]; then
  exit 0
fi

GUIDANCE="For a new task in Plan Mode, do not reset while planning. Treat \`origin/main\` as the source of truth and inspect relevant files from \`origin/main\` with \`git diff\` or \`git show\`; after the plan is accepted, run unforced \`./dev/reset-worktree\` before editing. For resumed work, preserve the current branch and run \`./dev/rebase-onto-main\` after the plan is accepted. If the working tree is dirty or the task intent is ambiguous, ask whether this is new or resumed work. Never infer \`--force\`."

MESSAGE="$(printf '%s' "$REPORT" | jq -r --arg guidance "$GUIDANCE" '
  "⚠️  Worktree base check: branch `\(.branch)`" +
  (if .status == "unknown" and .ahead == null then
    "; working tree is \(.tree); `origin/main` is unavailable, so freshness is unknown. Retry `git fetch origin` before relying on the current checkout."
  else
    " " + ({"matches":"matches","behind":"is behind","ahead":"is ahead of","diverged":"has diverged from"}[.relation] // "could not be compared with")
    + " `origin/main` (\(.ahead // "?") ahead, \(.behind // "?") behind); working tree is \(.tree)."
    + (if .status == "fetch-failed" then " The refresh of `origin/main` failed, so freshness is unknown. Retry `git fetch origin` before relying on this comparison." else "" end)
  end) + " " + $guidance')"

jq -n --arg m "$MESSAGE" '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":$m}}'
