#!/usr/bin/env bash
set -euo pipefail

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"

usage() { echo "Usage: ./dev/cleanup [--yes|-y] [--max-worktrees N] [--timeout-ms N] [--pr-limit N] [--after PATH]"; }
if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then usage; exit 0; fi
AUTO_YES=false
RECLAIM_ARGS=()
RECLAIM_SEEN=" "
RESUME_COMMAND='./dev/cleanup'
while [ "$#" -gt 0 ]; do
    arg=$1
    case "$arg" in
        --yes|-y)
            if $AUTO_YES; then echo "Error: duplicate option: $arg" >&2; usage >&2; exit 2; fi
            AUTO_YES=true
            ;;
        --max-worktrees|--timeout-ms|--pr-limit|--after)
            case "$RECLAIM_SEEN" in
                *" $arg "*) echo "Error: duplicate option: $arg" >&2; usage >&2; exit 2 ;;
            esac
            RECLAIM_SEEN+="$arg "
            if [ "$#" -lt 2 ] || [[ "$2" == -* ]]; then
                echo "Error: missing value for $arg" >&2; usage >&2; exit 2
            fi
            value=$2
            if [ "$arg" != --after ]; then
                if [[ ! "$value" =~ ^[1-9][0-9]*$ ]] ||
                    [[ ${#value} -gt 16 || ( ${#value} -eq 16 && "$value" -gt 9007199254740991 ) ]]; then
                    echo "Error: $arg requires a positive safe integer" >&2; usage >&2; exit 2
                fi
                if [ "$arg" = --pr-limit ] && [ "$value" -gt 10000 ]; then
                    echo "Error: --pr-limit must not exceed 10000" >&2; usage >&2; exit 2
                fi
                RESUME_COMMAND+=" $arg $value"
            fi
            RECLAIM_ARGS+=("$arg" "$value")
            shift
            ;;
        *) echo "Error: unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
    shift
done
if $AUTO_YES; then RESUME_COMMAND+=' --yes'; fi

# shellcheck source=lib/db-target.sh
source "$REPO_ROOT/dev/lib/db-target.sh"
# shellcheck source=lib/orphan-scan.sh
source "$REPO_ROOT/dev/lib/orphan-scan.sh"
# shellcheck source=lib/git-worktrees.sh
source "$REPO_ROOT/dev/lib/git-worktrees.sh"

if [ -f "$REPO_ROOT/.env" ]; then
    set -a
    set +u
    # shellcheck source=/dev/null
    source "$REPO_ROOT/.env"
    set -u
    set +a
    dev_db_target_resolve cleanup
    dev_db_target_export_pg_env
else
    unset DATABASE_URL
fi

should_scan_orphaned_dbs() {
    dev_db_target_local_or_allowed cleanup
}

echo -e "${BLUE}=== Voucha Worktree Cleanup ===${NC}\n"

# --- Finished worktrees ---
# `vouchington worktree reclaim` removes worktrees whose PR is merged or closed at their HEAD (dry
# run unless --yes). It runs from this checkout, which reclaim always keeps, and under the host-wide
# worktree-resource operation lock so it never removes a worktree while another worktree's
# ./dev/initialize holds that lock. The orphan scans after it reclaim the database and Valkey
# container of any worktree it removed.
reclaim_finished_worktrees() {
    local cli="$REPO_ROOT/node_modules/.bin/vouchington" locked=false
    local args=(worktree reclaim "${RECLAIM_ARGS[@]+"${RECLAIM_ARGS[@]}"}")
    echo -e "${BLUE}Reclaiming finished worktrees...${NC}"
    if [ ! -x "$cli" ]; then
        echo -e "${YELLOW}Skipping worktree reclaim: run pnpm install to get vouchington-tooling.${NC}\n"
        return 0
    fi
    if $AUTO_YES; then
        args+=(--yes)
        if worktree_resource_acquire_operation_lock; then
            locked=true
            trap worktree_resource_release_operation_lock EXIT
        else
            echo -e "${YELLOW}Skipping worktree reclaim: the worktree resource operation lock is unavailable (see above).${NC}\n"
            return 0
        fi
    fi
    (cd "$REPO_ROOT" && "$cli" "${args[@]}") |
        sed "s|^Scan incomplete; resume with |Scan incomplete; resume with $RESUME_COMMAND |" ||
        echo -e "${YELLOW}Worktree reclaim failed; continuing with orphan cleanup.${NC}"
    if $locked; then
        worktree_resource_release_operation_lock
        trap - EXIT
    fi
    echo ""
}
reclaim_finished_worktrees

refresh_live_worktree_paths() {
    WORKTREE_PATHS=()
    worktree_paths_append_command_output git_worktree_live_paths "$REPO_ROOT"
    worktree_paths_append_command_output worktree_resource_live_paths
}

resource_name_is_still_orphaned() {
    local candidate=$1 current
    shift
    for current in "$@"; do
        [ "$candidate" = "$current" ] && return 0
    done
    return 1
}

refresh_live_worktree_paths

echo -e "${BLUE}Live worktrees:${NC} ${#WORKTREE_PATHS[@]}"
for wt in "${WORKTREE_PATHS[@]+"${WORKTREE_PATHS[@]}"}"; do
    wt_branch=$(git -C "$wt" branch --show-current 2>/dev/null || echo "detached")
    echo "  $(worktree_dir_from_path "$wt") ($wt_branch) — $wt"
done
echo ""

# --- Orphaned PostgreSQL databases ---
echo -e "${BLUE}Scanning for orphaned PostgreSQL databases...${NC}"
if should_scan_orphaned_dbs; then
    scan_orphaned_dbs
else
    ORPHANED_DBS=()
    echo -e "${YELLOW}Skipping PostgreSQL cleanup for non-local database target; set VOUCHA_ALLOW_NON_LOCAL_DB_CLEANUP=1 to allow it.${NC}"
fi
if [ ${#ORPHANED_DBS[@]} -gt 0 ]; then
    echo -e "${YELLOW}Found ${#ORPHANED_DBS[@]} orphaned database(s):${NC}"
    for db in "${ORPHANED_DBS[@]}"; do
        echo "  - $db"
    done
    echo ""
    if $AUTO_YES; then
        CONFIRM="yes"
    else
        read -r -p "Drop these databases? (yes/no): " CONFIRM
    fi
    if [ "$CONFIRM" == "yes" ]; then
        CONFIRMED_DBS=("${ORPHANED_DBS[@]}")
        worktree_resource_acquire_operation_lock
        trap worktree_resource_release_operation_lock EXIT
        refresh_live_worktree_paths
        scan_orphaned_dbs
        for db in "${CONFIRMED_DBS[@]}"; do
            resource_name_is_still_orphaned "$db" "${ORPHANED_DBS[@]}" || continue
            if dropdb "$db" 2>/dev/null; then
                echo -e "${GREEN}✓ Dropped $db${NC}"
            else
                echo -e "${YELLOW}  Could not drop $db${NC}"
            fi
        done
        worktree_resource_release_operation_lock
        trap - EXIT
    else
        echo "  Skipped"
    fi
else
    echo -e "${GREEN}No orphaned databases${NC}"
fi
echo ""

# --- Orphaned Valkey containers ---
echo -e "${BLUE}Scanning for orphaned Valkey containers...${NC}"
scan_orphaned_containers
if [ ${#ORPHANED_CONTAINERS[@]} -gt 0 ]; then
    echo -e "${YELLOW}Found ${#ORPHANED_CONTAINERS[@]} orphaned Valkey container(s):${NC}"
    for container in "${ORPHANED_CONTAINERS[@]}"; do
        echo "  - $container"
    done
    echo ""
    if $AUTO_YES; then
        CONFIRM="yes"
    else
        read -r -p "Remove these containers? (yes/no): " CONFIRM
    fi
    if [ "$CONFIRM" == "yes" ]; then
        CONFIRMED_CONTAINERS=("${ORPHANED_CONTAINERS[@]}")
        worktree_resource_acquire_operation_lock
        trap worktree_resource_release_operation_lock EXIT
        refresh_live_worktree_paths
        scan_orphaned_containers
        for container in "${CONFIRMED_CONTAINERS[@]}"; do
            resource_name_is_still_orphaned "$container" "${ORPHANED_CONTAINERS[@]}" || continue
            docker rm -f "$container" >/dev/null 2>&1
            echo -e "${GREEN}✓ Removed $container${NC}"
        done
        worktree_resource_release_operation_lock
        trap - EXIT
    else
        echo "  Skipped"
    fi
else
    echo -e "${GREEN}No orphaned Valkey containers${NC}"
fi
echo ""

# --- Prunable worktrees ---
echo -e "${BLUE}Checking for prunable git worktrees...${NC}"
PRUNABLE=()
while IFS= read -r wt; do
    PRUNABLE+=("$wt")
done < <(git_worktree_prunable_paths "$REPO_ROOT")
if [ "${#PRUNABLE[@]}" -gt 0 ]; then
    echo -e "${YELLOW}Prunable worktrees (directory no longer exists):${NC}"
    for wt in "${PRUNABLE[@]+"${PRUNABLE[@]}"}"; do
        echo "  - $(worktree_dir_from_path "$wt") ($wt)"
    done
    echo ""
    if $AUTO_YES; then
        CONFIRM="yes"
    else
        read -r -p "Prune these worktrees? (yes/no): " CONFIRM
    fi
    if [ "$CONFIRM" == "yes" ]; then
        git worktree prune
        echo -e "${GREEN}✓ Pruned stale worktree entries${NC}"
    else
        echo "  Skipped"
    fi
else
    echo -e "${GREEN}No prunable worktrees${NC}"
fi
echo ""

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✓ Cleanup complete!${NC}"
echo -e "${GREEN}========================================${NC}\n"
