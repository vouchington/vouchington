#!/usr/bin/env bash
# Stop the local OTel collector + Jaeger stack.
set -euo pipefail

usage() { echo "Usage: ./dev/otel-down"; }
if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then usage; exit 0; fi
if [ "$#" -ne 0 ]; then echo "Error: ./dev/otel-down does not accept arguments." >&2; usage >&2; exit 2; fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

docker compose -f "$REPO_ROOT/dev/otel/compose.yaml" down

echo "OTel stack stopped."
