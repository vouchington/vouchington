#!/usr/bin/env bash
set -euo pipefail

usage() { echo "Usage: ./dev/reset"; }
if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then usage; exit 0; fi
if [ "$#" -ne 0 ]; then echo "Error: ./dev/reset does not accept arguments." >&2; usage >&2; exit 2; fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"

# shellcheck source=lib/refuse-on-main.sh
source "$REPO_ROOT/dev/lib/refuse-on-main.sh"
refuse_on_main "./dev/reset" "$REPO_ROOT"

# shellcheck source=lib/db-name-from-url.sh
source "$REPO_ROOT/dev/lib/db-name-from-url.sh"
# shellcheck source=lib/worktree-resource-env.sh
source "$REPO_ROOT/dev/lib/worktree-resource-env.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Load environment
if [ ! -f "$REPO_ROOT/.env" ]; then
    echo -e "${RED}Error: .env not found. Run ./dev/initialize web first.${NC}"
    exit 1
fi

set -a
source "$REPO_ROOT/.env"
set +a

if [ -z "${DATABASE_URL:-}" ]; then
    echo -e "${RED}Error: DATABASE_URL is not set in .env.${NC}"
    exit 1
fi

DB_NAME=$(db_name_from_url)
if [ -z "$DB_NAME" ]; then
    echo -e "${RED}Error: Could not extract database name from DATABASE_URL.${NC}"
    exit 1
fi
refuse_shared_resources_on_disposable "./dev/reset" "$REPO_ROOT" "$DB_NAME" "${VALKEY_CONTAINER:-}"

echo -e "${BLUE}=== Resetting Worktree ===${NC}\n"
echo "  Database: $DB_NAME"
echo "  Valkey:   ${VALKEY_CONTAINER:-unknown}"
echo ""

echo -e "${YELLOW}Stopping services before reset...${NC}"
"$REPO_ROOT/dev/stop-services" --keep-valkey
echo ""

"$REPO_ROOT/dev/db-clean"
echo ""

# Run migrations
echo -e "${YELLOW}Running migrations...${NC}"
(cd "$REPO_ROOT/backend" && pnpm run db:migrate)
echo -e "${GREEN}✓ Migrations complete${NC}"
echo ""

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✓ Reset complete!${NC}"
echo -e "${GREEN}========================================${NC}\n"

echo -e "${BLUE}Next Steps:${NC}"
echo "  Restart your services: ./dev/tmux"
echo ""
