#!/usr/bin/env bash
# Prints tracked paths that differ between the worktree and the given target.
# Arguments: <target-rev>
set -euo pipefail

if [ "$#" -ne 1 ] || [ -z "$1" ] || [ "${1#-}" != "$1" ]; then
  echo "usage: dev/protected-checkout-diff <target-rev>" >&2
  exit 2
fi

repo="$(cd "$(dirname "$0")/.." && pwd -P)"
target="$1"
paths_file="$repo/dev/protected-checkout-paths.txt"
pathspec=""
pathspecs=()
while IFS= read -r pathspec || [ -n "$pathspec" ]; do
  if [ -n "$pathspec" ]; then
    pathspecs+=("$pathspec")
  fi
done < "$paths_file"

git -C "$repo" diff --name-only --diff-filter=ACDMRTUXB "$target" -- "${pathspecs[@]+"${pathspecs[@]}"}"
