#!/usr/bin/env bash
set -euo pipefail

# Prepare an Anthropic-hosted Claude Code cloud session container for Voucha work, then run
# ./dev/initialize. Cloud containers are disposable Ubuntu VMs running as root without
# vouchington-machines provisioning, so this script supplies the pieces that provisioning owns
# on developer machines (docs/development/harnesses/claude-cloud.md):
#
#   - Node.js from .nvmrc through the image's nvm (/opt/nvm), plus pnpm 12 and mise, linked into
#     ~/.local/bin, which precedes the image's default /opt/node22/bin on PATH. Later shells and
#     hooks in the session then resolve the pinned Node without sourcing nvm. After
#     ./dev/initialize runs `mise install`, the .mise.toml tool shims are linked there too.
#   - The Docker daemon, which the image installs but does not start.
#   - PostgreSQL 18 with pgvector (CI's digest-pinned image) on 127.0.0.1:5432 with a trusted
#     `postgres` superuser, exported as an explicit DATABASE_URL the way the initialize smoke test
#     does. The container has no $USER, so node-pg cannot default the role name.
#   - Image pulls through mirror.gcr.io, because anonymous Docker Hub pulls from shared cloud
#     egress are rate-limited.
#
# It refuses to run outside a Claude Code cloud session. Every step is idempotent; rerun it after
# a session resumes on a fresh VM, where the daemon and containers are no longer running.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SESSION_PATH="$PATH"

# shellcheck source=dev/lib/worktree-resource-env.sh
source "$REPO_ROOT/dev/lib/worktree-resource-env.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

POSTGRES_CONTAINER=voucha-cloud-postgres
IMAGE_MIRROR=mirror.gcr.io
LOCAL_BIN="$HOME/.local/bin"

print_usage() {
  echo "Usage: ./dev/claude-cloud [monorepo|backend|web]"
  echo ""
  echo "Prepare a Claude Code cloud session container, then run ./dev/initialize <mode>."
  echo ""
  echo "  monorepo  Pinned Node.js and pnpm, then ./dev/initialize monorepo"
  echo "  backend   monorepo + Docker daemon and PostgreSQL 18 (default)"
  echo "  web       backend + ./dev/initialize web"
  echo ""
  echo "Runs only in a Claude Code cloud session (CLAUDE_CODE_REMOTE=true). Set"
  echo "VOUCHA_CLAUDE_CLOUD=1 to run it from a cloud environment setup script."
}

usage_error() {
  echo -e "${RED}Error: $1${NC}" >&2
  print_usage >&2
  exit 2
}

MODE=backend
mode_set=0
show_help=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) show_help=1 ;;
    monorepo | backend | web)
      [ "$mode_set" = 0 ] || usage_error "Only one mode may be given."
      MODE=$1
      mode_set=1
      ;;
    *) usage_error "Unknown argument: $1" ;;
  esac
  shift
done

if [ "$show_help" = 1 ]; then
  print_usage
  exit 0
fi

if [ "${CLAUDE_CODE_REMOTE:-}" != true ] && [ "${VOUCHA_CLAUDE_CLOUD:-}" != 1 ]; then
  echo -e "${RED}Error: ./dev/claude-cloud only prepares Claude Code cloud session containers.${NC}" >&2
  echo "Provision developer machines with https://github.com/vouchington/vouchington-machines and run ./dev/initialize." >&2
  exit 1
fi
if [ "$(uname -s)" != Linux ] || [ "$(id -u)" != 0 ]; then
  echo -e "${RED}Error: expected the cloud container's root user on Linux.${NC}" >&2
  exit 1
fi

cd "$REPO_ROOT"

install_node() {
  local nvm_dir node_bin_dir pnpm_major
  echo -e "${BLUE}Installing Node.js $(cat .nvmrc) from .nvmrc...${NC}"
  nvm_dir="${NVM_DIR:-}"
  if [ -z "$nvm_dir" ] || [ ! -s "$nvm_dir/nvm.sh" ]; then
    nvm_dir=/opt/nvm
    [ -s "$HOME/.nvm/nvm.sh" ] && nvm_dir="$HOME/.nvm"
  fi
  if [ ! -s "$nvm_dir/nvm.sh" ]; then
    echo -e "${RED}Error: nvm not found at /opt/nvm or ~/.nvm; the cloud image changed.${NC}" >&2
    exit 1
  fi
  export NVM_DIR="$nvm_dir"
  # nvm.sh reads unset variables and returns non-zero when .nvmrc names an uninstalled version.
  set +eu
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
  nvm install >/dev/null
  local nvm_status=$?
  set -eu
  if [ "$nvm_status" != 0 ]; then
    echo -e "${RED}Error: nvm install failed for Node.js $(cat .nvmrc).${NC}" >&2
    exit 1
  fi
  node_bin_dir="$(dirname "$(nvm which current)")"
  export PATH="$node_bin_dir:$PATH"

  pnpm_major=""
  if [ -x "$node_bin_dir/pnpm" ]; then
    pnpm_major="$("$node_bin_dir/pnpm" --version 2>/dev/null | cut -d. -f1 || true)"
  fi
  if [ "$pnpm_major" != 12 ]; then
    echo -e "${BLUE}Installing pnpm 12...${NC}"
    "$node_bin_dir/npm" install --global --silent pnpm@12
  fi
  if [ ! -x "$node_bin_dir/mise" ]; then
    echo -e "${BLUE}Installing mise...${NC}"
    "$node_bin_dir/npm" install --global --silent @jdxcode/mise
  fi

  mkdir -p "$LOCAL_BIN"
  local tool
  for tool in node npm npx pnpm pnpx mise; do
    if [ -e "$node_bin_dir/$tool" ]; then
      ln -sfn "$node_bin_dir/$tool" "$LOCAL_BIN/$tool"
    fi
  done
  if [ "$(PATH="$SESSION_PATH" command -v node)" != "$LOCAL_BIN/node" ]; then
    echo -e "${YELLOW}Warning: $LOCAL_BIN does not precede the image's Node.js on PATH; later shells keep $(PATH="$SESSION_PATH" node --version).${NC}"
  fi
  echo -e "${GREEN}✓ Node.js $(node --version), pnpm $(pnpm --version)${NC}\n"
}

start_docker() {
  if docker info >/dev/null 2>&1; then
    return
  fi
  echo -e "${BLUE}Starting the Docker daemon...${NC}"
  nohup dockerd >/var/log/voucha-dockerd.log 2>&1 &
  local _attempt
  for _attempt in $(seq 1 30); do
    if docker info >/dev/null 2>&1; then
      echo -e "${GREEN}✓ Docker is ready${NC}\n"
      return
    fi
    sleep 1
  done
  echo -e "${RED}Error: Docker did not start. See /var/log/voucha-dockerd.log.${NC}" >&2
  exit 1
}

# Pull a docker.io image reference through the mirror and tag it with the original reference so
# `docker run <ref>` in ./dev/initialize finds it locally. Falls back to Docker Hub.
ensure_image() {
  local ref=$1 mirror_ref
  # A digest-pinned reference is always pulled (a no-op once present) so a pin bump retags.
  if [ "${ref%@*}" = "$ref" ] && docker image inspect "$ref" >/dev/null 2>&1; then
    return
  fi
  mirror_ref="$IMAGE_MIRROR/$ref"
  case "$ref" in
    */*) ;;
    *) mirror_ref="$IMAGE_MIRROR/library/$ref" ;;
  esac
  echo -e "${BLUE}Pulling $ref...${NC}"
  if docker pull --quiet "$mirror_ref" >/dev/null && docker tag "$mirror_ref" "${ref%@*}"; then
    return
  fi
  echo -e "${YELLOW}Mirror pull failed; trying Docker Hub.${NC}"
  docker pull --quiet "$ref" >/dev/null
  [ "${ref%@*}" = "$ref" ] || docker tag "$ref" "${ref%@*}"
}

# Read image pins from their owners instead of duplicating them here.
pinned_image() {
  local pattern=$1 file=$2 ref
  ref="$(grep -oE "$pattern" "$file" | head -n1 || true)"
  if [ -z "$ref" ]; then
    echo -e "${RED}Error: could not find an image matching $pattern in $file.${NC}" >&2
    exit 1
  fi
  printf '%s' "$ref"
}

start_postgres() {
  local image
  image="$(pinned_image 'pgvector/pgvector:pg18@sha256:[0-9a-f]+' .github/workflows/initialize-smoke-test.yml)"
  ensure_image "$image"

  if [ "$(docker inspect -f '{{.State.Running}}' "$POSTGRES_CONTAINER" 2>/dev/null || true)" != true ]; then
    echo -e "${BLUE}Starting PostgreSQL 18 on 127.0.0.1:5432...${NC}"
    if docker inspect "$POSTGRES_CONTAINER" >/dev/null 2>&1; then
      docker start "$POSTGRES_CONTAINER" >/dev/null
    else
      docker run -d \
        --name "$POSTGRES_CONTAINER" \
        --restart unless-stopped \
        -e POSTGRES_DB=postgres \
        -e POSTGRES_HOST_AUTH_METHOD=trust \
        -e POSTGRES_USER=postgres \
        -e POSTGRES_INITDB_ARGS="-c max_connections=300" \
        -p 127.0.0.1:5432:5432 \
        "${image%@*}" >/dev/null
    fi
  fi

  local _attempt
  for _attempt in $(seq 1 30); do
    if pg_isready -q -h localhost -p 5432; then
      echo -e "${GREEN}✓ PostgreSQL is ready${NC}\n"
      export DATABASE_URL
      DATABASE_URL="postgres://postgres@localhost:5432/$(worktree_resource_owned_db_name "$REPO_ROOT")"
      return
    fi
    sleep 1
  done
  echo -e "${RED}Error: PostgreSQL did not become ready. Check: docker logs $POSTGRES_CONTAINER${NC}" >&2
  exit 1
}

install_node
if [ "$MODE" != monorepo ]; then
  start_docker
  ensure_image "$(pinned_image 'valkey/valkey-bundle:[0-9.]+' dev/initialize)"
  start_postgres
fi

SKIP_NVM_INSTALL=1 ./dev/initialize "$MODE"

# ./dev/initialize treats a failed `mise install` as a warning; link whatever shims exist.
mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
if [ -d "$mise_shims" ]; then
  for shim in "$mise_shims"/*; do
    [ -e "$shim" ] || continue
    ln -sfn "$shim" "$LOCAL_BIN/$(basename "$shim")"
  done
  echo -e "${GREEN}✓ Linked mise tool shims into $LOCAL_BIN${NC}"
fi
