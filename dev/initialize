#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

# shellcheck source=dev/lib/schema-drift-detectors.sh
source "$REPO_ROOT/dev/lib/schema-drift-detectors.sh"
# shellcheck source=dev/lib/db-target.sh
source "$REPO_ROOT/dev/lib/db-target.sh"
# shellcheck source=dev/lib/worktree-resource-env.sh
source "$REPO_ROOT/dev/lib/worktree-resource-env.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# shellcheck source=dev/lib/git-index-lock.sh
source "$REPO_ROOT/dev/lib/git-index-lock.sh"

register_live_worktree_resource_paths() {
    local repo_root=$1
    local live_worktree

    while IFS= read -r live_worktree; do
        register_worktree_resource_path "$live_worktree"
    done < <(git_worktree_live_paths "$repo_root")
    # Standalone disposable clones may not appear in their own Git worktree inventory.
    register_worktree_resource_path "$repo_root"
}

# Repairs the shared .git/config for corruption caused by `git worktree add`
# (git >= 2.36) setting extensions.worktreeConfig=true without ever creating the
# required per-worktree config.worktree files (see docs/development/git-worktree-locks.md):
#   - core.bare flips to true during git push (the fetch/push.autoSetupRemote
#     config write lands in the shared config instead of a missing config.worktree).
#   - core.worktree gets set to a linked worktree's path in the shared config,
#     redirecting every git command in every worktree sharing this .git dir to
#     read/write that worktree's files instead of its own.
# Runs on every init via --file to bypass worktreeConfig routing (which would look
# for the missing config.worktree file).
heal_shared_git_config() {
    local common_config="$1"
    git config --file "$common_config" core.bare false 2>/dev/null || true
    git config --file "$common_config" --unset-all extensions.worktreeConfig 2>/dev/null || true
    git config --file "$common_config" --unset-all core.worktree 2>/dev/null || true
}

# Wipe Wrangler/Miniflare and Next.js dev caches so a re-init produces a clean
# slate. Run only after non-mutating web prerequisites pass so failed preflight
# checks do not remove cache/build output from an otherwise usable workspace.
clear_dev_caches() {
    local path
    for path in "$@"; do
        if [ -d "$path" ]; then
            rm -rf "$path"
            echo -e "${GREEN}✓ Cleared $path${NC}"
        fi
    done
}

retry_command() {
    local max_attempts=$1
    local delay_seconds=$2
    local description=$3
    local attempt=1
    local status
    shift 3

    while :; do
        "$@" && return 0
        status=$?
        if [ "$attempt" -ge "$max_attempts" ]; then
            return "$status"
        fi
        echo -e "${YELLOW}Warning:${NC} attempt $attempt failed for $description; retrying in ${delay_seconds}s..."
        sleep "$delay_seconds"
        attempt=$((attempt + 1))
    done
}

HOST_STORAGE_MINIMUM_FREE_KIB=5242880

check_bootstrap_storage_path() {
    local label=$1
    local path=$2
    local df_output
    local available_kib
    local filesystem_key
    local quoted_path
    local seen_key

    if [ -z "$path" ] || ! df_output=$(LC_ALL=C df -Pk -- "$path" 2>/dev/null); then
        printf -v quoted_path '%q' "$path"
        echo -e "${RED}Error: Could not measure free host storage for $label ($quoted_path).${NC}" >&2
        echo "Inspect it with: df -h $quoted_path. Free host storage, then retry." >&2
        return 1
    fi
    available_kib=$(printf '%s\n' "$df_output" | awk 'END {print $4}')
    filesystem_key=$(printf '%s\n' "$df_output" | awk 'END {print $1}')
    case "$filesystem_key" in
        '')
            printf -v quoted_path '%q' "$path"
            echo -e "${RED}Error: Could not parse free host storage for $label ($quoted_path).${NC}" >&2
            return 1
            ;;
    esac
    case "$available_kib" in
        ''|*[!0-9]*)
            printf -v quoted_path '%q' "$path"
            echo -e "${RED}Error: Could not parse free host storage for $label ($quoted_path).${NC}" >&2
            return 1
            ;;
    esac
    for seen_key in "${BOOTSTRAP_STORAGE_FILESYSTEMS[@]+"${BOOTSTRAP_STORAGE_FILESYSTEMS[@]}"}"; do
        [ "$seen_key" = "$filesystem_key" ] && return 0
    done
    BOOTSTRAP_STORAGE_FILESYSTEMS+=("$filesystem_key")
    if [ "$available_kib" -lt "$HOST_STORAGE_MINIMUM_FREE_KIB" ]; then
        printf -v quoted_path '%q' "$path"
        echo -e "${RED}Error: Insufficient host storage for $label; 5.00 GiB required.${NC}" >&2
        echo "Inspect it with: df -h $quoted_path. Free host storage, then retry." >&2
        return 1
    fi
    return 0
}

check_bootstrap_host_storage() {
    local failed=0
    local temporary_directory="${TMPDIR:-${TMP:-${TEMP:-/tmp}}}"
    local BOOTSTRAP_STORAGE_FILESYSTEMS=()

    check_bootstrap_storage_path "worktree" "$REPO_ROOT" || failed=1
    check_bootstrap_storage_path "home directory" "${HOME:-}" || failed=1
    check_bootstrap_storage_path "temporary directory" "$temporary_directory" || failed=1
    return "$failed"
}

ensure_node_version() {
    echo -e "${BLUE}Installing Node.js version...${NC}"
    if [ "${SKIP_NVM_INSTALL:-}" = "1" ]; then
        echo -e "${YELLOW}Warning: SKIP_NVM_INSTALL=1, using Node.js from PATH${NC}"
        echo ""
        return 0
    fi

    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    # shellcheck source=/dev/null
    if [ -s "$NVM_DIR/nvm.sh" ]; then
        \. "$NVM_DIR/nvm.sh"
        nvm install
    else
        echo -e "${YELLOW}Warning: nvm not found at $NVM_DIR/nvm.sh${NC}"
        echo -e "${YELLOW}Node.js should still be available from PATH (e.g., from a prior nvm install)${NC}"
    fi
    echo ""
}

read_existing_env_var() {
    local key=$1

    [ -f .env ] || return 0

    (
        set +u
        set -a
        # shellcheck source=/dev/null
        source .env >/dev/null 2>&1 || exit 0
        set +a
        printf '%s' "${!key-}"
    )
}

read_env_example_var() {
    local key=$1

    [ -f .env.example ] || return 0

    (
        set +u
        set -a
        # shellcheck source=/dev/null
        source .env.example >/dev/null 2>&1 || exit 0
        set +a
        printf '%s' "${!key-}"
    )
}

extract_port_from_url() {
    local url=${1:-}

    if [[ "$url" =~ :([0-9]+)(/.*)?$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
}

is_valid_port() {
    local port=${1:-}

    [[ "$port" =~ ^[0-9]+$ ]] && ((10#$port >= 1 && 10#$port <= 65535))
}

load_runner_port_policy() {
    local policy_values

    # Read the JSON directly. The TypeScript loader validates it for Node
    # consumers; initialize cannot import that module because some callers
    # (and this script's own isolated tests) run without node_modules.
    # shellcheck disable=SC2016 # JavaScript template literal is evaluated by node, not Bash.
    policy_values=$(node -e '
import { readFileSync } from "node:fs"
const policy = JSON.parse(readFileSync(process.argv[1], "utf8"))
if (!Number.isInteger(policy.reservedPortStart) || !Number.isInteger(policy.reservedPortEnd)) {
  process.exit(1)
}
console.log(`${policy.reservedPortStart} ${policy.reservedPortEnd}`)
' "$REPO_ROOT/ci/runner-port-policy.json") || {
        echo -e "${RED}Error: Invalid CI runner port policy at ci/runner-port-policy.json${NC}"
        exit 1
    }
    read -r RUNNER_RESERVED_PORT_START RUNNER_RESERVED_PORT_END <<< "$policy_values"
}

is_allocatable_worktree_port() {
    local port=${1:-}

    is_valid_port "$port" \
        && ! ((10#$port >= RUNNER_RESERVED_PORT_START && 10#$port <= RUNNER_RESERVED_PORT_END)) \
        && ((10#$port != 8787))
}

is_distinct_from_assigned_core_ports() {
    local port=${1:-}

    is_valid_port "$port" \
        && ((10#$port != 10#${BACKEND_PORT:-0})) \
        && ((10#$port != 10#${NEXT_PORT:-0})) \
        && ((10#$port != 10#${VALKEY_PORT:-0})) \
        && ((10#$port != 10#${WORKER_PORT:-0})) \
        && ((10#$port != 10#${IMAGE_LAMBDA_PORT:-0}))
}

allocate_random_ports() {
    local count=${1:-6}
    node -e "
const net = require('node:net')
const count = ${count}
function openPort() {
  return new Promise(resolve => {
    const server = net.createServer()
    server.listen(0, () => resolve(server))
  })
}
Promise.all(Array.from({ length: count }, () => openPort()))
  .then(servers => {
    console.log(servers.map(server => server.address().port).join(' '))
    servers.forEach(server => server.close())
  })
"
}

assign_worktree_ports() {
    local existing_backend_port existing_next_port existing_valkey_port existing_worker_port
    local existing_image_lambda_port existing_valkey_url existing_inspector_port existing_storybook_port reused_ports allocated_ports
    local existing_worktree_dir

    load_runner_port_policy

    # Entrypoint port: always fixed for main
    if $IS_MAIN; then
        WORKER_PORT=8787
    fi

    existing_backend_port=$(read_existing_env_var PORT)
    existing_next_port=$(read_existing_env_var NEXT_PORT)
    existing_valkey_url=$(read_existing_env_var VALKEY_URL)
    existing_valkey_port=$(extract_port_from_url "$existing_valkey_url")
    existing_image_lambda_port=$(read_existing_env_var IMAGE_LAMBDA_PORT)
    existing_inspector_port=$(read_existing_env_var INSPECTOR_PORT)
    existing_storybook_port=$(read_existing_env_var STORYBOOK_PORT)
    existing_worker_port=$(read_existing_env_var WORKER_PORT)

    if ! is_valid_port "$existing_valkey_port" && [ -f .valkey-port ]; then
        existing_valkey_port=$(tr -d '[:space:]' < .valkey-port)
    fi

    existing_worktree_dir=$(read_existing_env_var WORKTREE_DIR)
    if [ -n "$existing_worktree_dir" ] && [ "$existing_worktree_dir" != "$WORKTREE_DIR" ]; then
        echo -e "${YELLOW}Warning:${NC} .env was written for worktree '$existing_worktree_dir' but this is '$WORKTREE_DIR'. Discarding stale ports."
        echo -e "${YELLOW}After initialization, ./dev/cleanup removes orphaned hashed resources; verify and remove legacy names explicitly.${NC}"
        existing_backend_port=""
        existing_next_port=""
        existing_valkey_port=""
        existing_worker_port=""
        existing_image_lambda_port=""
        existing_inspector_port=""
        existing_storybook_port=""
    fi

    reused_ports=false

    if $IS_MAIN; then
        if is_allocatable_worktree_port "$existing_backend_port" \
            && is_allocatable_worktree_port "$existing_next_port" \
            && is_allocatable_worktree_port "$existing_valkey_port" \
            && is_allocatable_worktree_port "$existing_image_lambda_port"; then
            BACKEND_PORT=$existing_backend_port
            NEXT_PORT=$existing_next_port
            VALKEY_PORT=$existing_valkey_port
            IMAGE_LAMBDA_PORT=$existing_image_lambda_port
            reused_ports=true
        else
            while :; do
                allocated_ports=$(allocate_random_ports 4)
                read -r BACKEND_PORT NEXT_PORT VALKEY_PORT IMAGE_LAMBDA_PORT <<< "$allocated_ports"
                if is_allocatable_worktree_port "$BACKEND_PORT" \
                    && is_allocatable_worktree_port "$NEXT_PORT" \
                    && is_allocatable_worktree_port "$VALKEY_PORT" \
                    && is_allocatable_worktree_port "$IMAGE_LAMBDA_PORT"; then
                    break
                fi
            done
        fi

        if [ -z "${BACKEND_PORT:-}" ] || [ -z "${NEXT_PORT:-}" ] || [ -z "${VALKEY_PORT:-}" ] || [ -z "${IMAGE_LAMBDA_PORT:-}" ]; then
            echo -e "${RED}Error: Failed to determine ports. Is Node.js working correctly?${NC}"
            exit 1
        fi
    else
        if is_allocatable_worktree_port "$existing_backend_port" \
            && is_allocatable_worktree_port "$existing_next_port" \
            && is_allocatable_worktree_port "$existing_valkey_port" \
            && is_allocatable_worktree_port "$existing_worker_port" \
            && is_allocatable_worktree_port "$existing_image_lambda_port"; then
            BACKEND_PORT=$existing_backend_port
            NEXT_PORT=$existing_next_port
            VALKEY_PORT=$existing_valkey_port
            WORKER_PORT=$existing_worker_port
            IMAGE_LAMBDA_PORT=$existing_image_lambda_port
            reused_ports=true
        else
            # Re-roll reserved main and CI runner ports from ephemeral allocation.
            while :; do
                allocated_ports=$(allocate_random_ports 5)
                read -r BACKEND_PORT NEXT_PORT VALKEY_PORT WORKER_PORT IMAGE_LAMBDA_PORT <<< "$allocated_ports"
                if is_allocatable_worktree_port "$BACKEND_PORT" \
                    && is_allocatable_worktree_port "$NEXT_PORT" \
                    && is_allocatable_worktree_port "$VALKEY_PORT" \
                    && is_allocatable_worktree_port "$WORKER_PORT" \
                    && is_allocatable_worktree_port "$IMAGE_LAMBDA_PORT"; then
                    break
                fi
            done
        fi

        if [ -z "${BACKEND_PORT:-}" ] || [ -z "${NEXT_PORT:-}" ] || [ -z "${VALKEY_PORT:-}" ] || [ -z "${WORKER_PORT:-}" ] || [ -z "${IMAGE_LAMBDA_PORT:-}" ]; then
            echo -e "${RED}Error: Failed to determine ports. Is Node.js working correctly?${NC}"
            exit 1
        fi

        if $reused_ports; then
            echo -e "${GREEN}Detected worktree:${NC} $WORKTREE_DIR (reusing saved ports)"
        else
            BRANCH=$(git branch --show-current 2>/dev/null || echo "detached")
            echo -e "${GREEN}Detected worktree:${NC} $WORKTREE_DIR (branch: $BRANCH)"
        fi
    fi

    # INSPECTOR_PORT is allocated independently so pre-existing worktrees
    # without it keep their other ports intact on re-initialize.
    if is_allocatable_worktree_port "$existing_inspector_port" \
        && is_distinct_from_assigned_core_ports "$existing_inspector_port"; then
        INSPECTOR_PORT=$existing_inspector_port
    else
        # Loop until we get a valid port that doesn't conflict with already-assigned ports.
        while :; do
            INSPECTOR_PORT=$(allocate_random_ports 1)
            if is_allocatable_worktree_port "$INSPECTOR_PORT" \
                && is_distinct_from_assigned_core_ports "$INSPECTOR_PORT"; then
                break
            fi
        done
    fi

    # STORYBOOK_PORT is allocated independently so pre-existing worktrees
    # without it keep their other ports intact on re-initialize.
    if is_allocatable_worktree_port "$existing_storybook_port" \
        && is_distinct_from_assigned_core_ports "$existing_storybook_port" \
        && ((10#$existing_storybook_port != 10#${INSPECTOR_PORT:-0})); then
        STORYBOOK_PORT=$existing_storybook_port
    else
        while :; do
            STORYBOOK_PORT=$(allocate_random_ports 1)
            if is_allocatable_worktree_port "$STORYBOOK_PORT" \
                && is_distinct_from_assigned_core_ports "$STORYBOOK_PORT" \
                && [ "$STORYBOOK_PORT" != "${INSPECTOR_PORT:-}" ]; then
                break
            fi
        done
    fi
}

ensure_valkey_container() {
    local existing_container_port recreate_reason port_owner

    echo -e "${BLUE}Ensuring Valkey container: $VALKEY_CONTAINER (port $VALKEY_PORT)...${NC}"
    recreate_reason=""

    if docker ps -a --format '{{.Names}}' | grep -qx "$VALKEY_CONTAINER"; then
        existing_container_port=$(
            docker inspect -f '{{with (index .NetworkSettings.Ports "6379/tcp")}}{{with index . 0}}{{.HostPort}}{{end}}{{end}}' "$VALKEY_CONTAINER" 2>/dev/null || true
        )

        if [ "$existing_container_port" = "$VALKEY_PORT" ]; then
            if docker ps --format '{{.Names}}' | grep -qx "$VALKEY_CONTAINER"; then
                echo -e "${GREEN}✓ Reusing existing Valkey container${NC}"
            else
                docker start "$VALKEY_CONTAINER" >/dev/null
                echo -e "${GREEN}✓ Started existing Valkey container${NC}"
            fi
        else
            recreate_reason="port mapping ${existing_container_port:-missing} -> $VALKEY_PORT"
        fi
    else
        recreate_reason="container missing"
    fi

    if [ -n "$recreate_reason" ]; then
        if [ "${IS_MAIN:-false}" = true ] \
            && docker ps -a --format '{{.Names}}' | grep -qx "$VALKEY_CONTAINER" \
            && [ "${FORCE_MAIN_VALKEY_RECREATE:-}" != "1" ]; then
            echo -e "${RED}Error: Refusing to recreate main Valkey container $VALKEY_CONTAINER (${recreate_reason}).${NC}" >&2
            echo "Re-run with FORCE_MAIN_VALKEY_RECREATE=1 if replacing the main Valkey container is intentional." >&2
            exit 1
        fi

        port_owner=$(docker ps -a --filter "publish=$VALKEY_PORT" --format '{{.Names}}' 2>/dev/null | head -n1 || true)

        if [ -n "$port_owner" ] && [ "$port_owner" != "$VALKEY_CONTAINER" ]; then
            echo -e "${RED}Error: Port $VALKEY_PORT is already in use by $port_owner.${NC}"
            echo "Stop that container or choose a different Valkey port before re-running ./dev/initialize."
            exit 1
        fi

        if docker ps -a --format '{{.Names}}' | grep -qx "$VALKEY_CONTAINER"; then
            docker rm -f "$VALKEY_CONTAINER" >/dev/null 2>&1
        fi

        if ! docker run -d \
            --name "$VALKEY_CONTAINER" \
            -p "$VALKEY_PORT:6379" \
            --restart unless-stopped \
            valkey/valkey-bundle:9.1.0 \
            >/dev/null; then
            echo -e "${RED}Error: Failed to start Valkey container.${NC}"
            echo "Check if port $VALKEY_PORT is already in use or if Docker has sufficient resources."
            exit 1
        fi

        echo -e "${GREEN}✓ Created Valkey container (${recreate_reason})${NC}"
    fi

    for i in $(seq 1 30); do
        if docker exec "$VALKEY_CONTAINER" valkey-cli ping >/dev/null 2>&1; then
            echo -e "${GREEN}✓ Valkey is ready${NC}\n"
            return
        fi

        if [ "$i" -eq 30 ]; then
            echo -e "${RED}Error: Valkey container failed to start. Check: docker logs $VALKEY_CONTAINER${NC}"
            exit 1
        fi

        sleep 0.5
    done
}

configure_web_push_keys() {
    local existing_public_key existing_private_key existing_subject vapid_output

    echo -e "${BLUE}Configuring Web Push VAPID keys...${NC}"

    if [ -n "${WEB_PUSH_PUBLIC_KEY:-}" ] && [ -n "${WEB_PUSH_PRIVATE_KEY:-}" ]; then
        FINAL_WEB_PUSH_PUBLIC_KEY=$WEB_PUSH_PUBLIC_KEY
        FINAL_WEB_PUSH_PRIVATE_KEY=$WEB_PUSH_PRIVATE_KEY
        FINAL_WEB_PUSH_SUBJECT="${WEB_PUSH_SUBJECT:-mailto:team@voucha.ai}"
        echo -e "${GREEN}✓ Using existing Web Push VAPID keys from shared environment${NC}"
    else
        existing_public_key=$(read_existing_env_var WEB_PUSH_PUBLIC_KEY)
        existing_private_key=$(read_existing_env_var WEB_PUSH_PRIVATE_KEY)
        existing_subject=$(read_existing_env_var WEB_PUSH_SUBJECT)

        if [ -n "$existing_public_key" ] && [ -n "$existing_private_key" ]; then
            FINAL_WEB_PUSH_PUBLIC_KEY=$existing_public_key
            FINAL_WEB_PUSH_PRIVATE_KEY=$existing_private_key
            FINAL_WEB_PUSH_SUBJECT="${existing_subject:-mailto:team@voucha.ai}"
            echo -e "${GREEN}✓ Reusing existing local Web Push VAPID keys${NC}"
        else
            vapid_output=$(cd backend/services/notifications-push && pnpm exec web-push generate-vapid-keys)
            FINAL_WEB_PUSH_PUBLIC_KEY=$(printf '%s\n' "$vapid_output" | awk '/Public Key:/{getline; print}')
            FINAL_WEB_PUSH_PRIVATE_KEY=$(printf '%s\n' "$vapid_output" | awk '/Private Key:/{getline; print}')

            if [ -z "$FINAL_WEB_PUSH_PUBLIC_KEY" ] || [ -z "$FINAL_WEB_PUSH_PRIVATE_KEY" ]; then
                echo -e "${RED}Error: Failed to generate Web Push VAPID keys.${NC}"
                exit 1
            fi

            FINAL_WEB_PUSH_SUBJECT='mailto:team@voucha.ai'
            echo -e "${GREEN}✓ Generated local Web Push VAPID keys${NC}"
        fi
    fi

    echo -e "${GREEN}✓ Web Push subject:${NC} $FINAL_WEB_PUSH_SUBJECT"
    echo ""
}

configure_cf_worker_secret() {
    echo -e "${BLUE}Configuring CF Worker shared secret...${NC}"

    if [ -n "${CF_WORKER_SECRET:-}" ]; then
        echo -e "${GREEN}✓ Using existing CF_WORKER_SECRET from shared environment${NC}"
    else
        local existing_secret
        existing_secret=$(read_existing_env_var CF_WORKER_SECRET)

        if [ -n "$existing_secret" ]; then
            CF_WORKER_SECRET=$existing_secret
            echo -e "${GREEN}✓ Reusing existing local CF_WORKER_SECRET${NC}"
        else
            CF_WORKER_SECRET=$(openssl rand -hex 32)
            echo -e "${GREEN}✓ Generated CF_WORKER_SECRET${NC}"
        fi
    fi
    echo ""
}

