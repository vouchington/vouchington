has_non_empty_env_var() {
    local key=$1
    local value="${!key-}"

    [[ -n "$(printf '%s' "$value" | tr -d '[:space:]')" ]]
}

has_env_pair() {
    local access_key_var=$1
    local secret_key_var=$2

    has_non_empty_env_var "$access_key_var" && has_non_empty_env_var "$secret_key_var"
}

append_env_var_if_set() {
    local key=$1

    if has_non_empty_env_var "$key"; then
        printf 'export %s=%q\n' "$key" "${!key}"
    fi
}

# Emits `export KEY=VALUE` only when VALUE is non-empty — the same shape as
# append_env_var_if_set, but for a value already resolved into a variable
# (typically via resolve_preserved_env_var below) rather than read directly
# off a same-named process environment variable.
append_env_var_value() {
    local key=$1
    local value=$2

    if [ -n "$value" ]; then
        printf 'export %s=%q\n' "$key" "$value"
    fi
}

# Resolves a value whose configurer may not have run this invocation because
# it is gated to a higher mode (e.g. configure_cf_worker_secret and
# configure_turnstile_keys are web-only, but write_worktree_env now also runs
# in backend mode): prefer the live shell variable SHELL_KEY when this run's
# own setup declared it — even to an intentionally empty string, as
# configure_turnstile_keys does when neither key is configured — falling back
# to whatever a prior run wrote to .env under ENV_KEY (default: same name as
# SHELL_KEY) before write_worktree_env truncates it. `declare -p` is the "did
# this run's configurer touch it at all" test; a plain non-empty check would
# wrongly treat an intentional empty result as "never ran" and resurrect a
# stale preserved value.
resolve_preserved_env_var() {
    local shell_key=$1
    local env_key="${2:-$shell_key}"

    if declare -p "$shell_key" >/dev/null 2>&1; then
        printf '%s' "${!shell_key}"
        return
    fi
    read_existing_env_var "$env_key"
}

append_s3_credentials_to_env() {
    if has_env_pair S3_AWS_ACCESS_KEY_ID S3_AWS_SECRET_ACCESS_KEY; then
        append_env_var_if_set S3_AWS_ACCESS_KEY_ID
        append_env_var_if_set S3_AWS_SECRET_ACCESS_KEY
        append_env_var_if_set S3_AWS_SESSION_TOKEN
        return
    fi

    append_env_var_if_set AWS_ACCESS_KEY_ID
    append_env_var_if_set AWS_SECRET_ACCESS_KEY
    append_env_var_if_set AWS_SESSION_TOKEN
}

print_s3_credentials_note() {
    echo -e "${YELLOW}Note: S3 credentials are not configured.${NC}" >&2
    echo "The app can start, but S3-backed features such as image uploads, sitemap/crawl storage, and user exports require credentials when used." >&2
    echo "To enable those features locally, add one of these credential pairs to ~/voucha.env, then rerun ./dev/initialize web:" >&2
    echo "  export S3_AWS_ACCESS_KEY_ID=..." >&2
    echo "  export S3_AWS_SECRET_ACCESS_KEY=..." >&2
    echo "  # Optional when using temporary credentials:" >&2
    echo "  export S3_AWS_SESSION_TOKEN=..." >&2
    echo "" >&2
    echo "Fallback shared AWS credentials are also accepted:" >&2
    echo "  export AWS_ACCESS_KEY_ID=..." >&2
    echo "  export AWS_SECRET_ACCESS_KEY=..." >&2
    echo "  # Optional when using temporary credentials:" >&2
    echo "  export AWS_SESSION_TOKEN=..." >&2
}

validate_s3_credentials() {
    echo -e "${BLUE}Validating S3 credentials...${NC}"

    if has_env_pair S3_AWS_ACCESS_KEY_ID S3_AWS_SECRET_ACCESS_KEY; then
        echo -e "${GREEN}✓ Found S3_AWS_* credentials${NC}\n"
        return
    fi

    if has_env_pair AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; then
        echo -e "${GREEN}✓ Found fallback AWS_* credentials for S3${NC}\n"
        return
    fi

    print_s3_credentials_note
    echo ""
}

configure_turnstile_keys() {
    # Apply Turnstile keys as a matched pair. A real site key + test secret (or vice versa)
    # would cause the frontend to issue real tokens that the backend then rejects.
    # When neither is set, leave them empty — code-level defaults in
    # web/lib/turnstile-config.ts and backend/services/captcha/verify.mts use Cloudflare's
    # public always-pass test keys.
    # Trim whitespace so a value like "  " is treated as unset, matching the
    # `.trim()` checks in next.config.ts and verify.mts.
    local trimmed_public_site_key trimmed_secret_key
    local TRIMMED_TURNSTILE_SITE_KEY TRIMMED_TURNSTILE_SECRET_KEY

    trimmed_public_site_key="$(printf '%s' "${NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY:-}" | awk '{$1=$1; print}')"
    trimmed_secret_key="$(printf '%s' "${CLOUDFLARE_TURNSTILE_SECRET_KEY:-}" | awk '{$1=$1; print}')"

    TRIMMED_TURNSTILE_SITE_KEY="$trimmed_public_site_key"
    TRIMMED_TURNSTILE_SECRET_KEY="$trimmed_secret_key"

    if [ -n "$TRIMMED_TURNSTILE_SITE_KEY" ] && [ -n "$TRIMMED_TURNSTILE_SECRET_KEY" ]; then
        EFFECTIVE_TURNSTILE_SITE_KEY="$TRIMMED_TURNSTILE_SITE_KEY"
        EFFECTIVE_TURNSTILE_SECRET_KEY="$TRIMMED_TURNSTILE_SECRET_KEY"
    else
        EFFECTIVE_TURNSTILE_SITE_KEY=""
        EFFECTIVE_TURNSTILE_SECRET_KEY=""
        echo -e "${YELLOW}Note: NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY / CLOUDFLARE_TURNSTILE_SECRET_KEY not set — falling back to Cloudflare's public always-pass test keys.${NC}"
        echo -e "${YELLOW}See https://developers.cloudflare.com/turnstile/troubleshooting/testing/${NC}\n"
    fi
}

write_worktree_env() {
    echo "$VALKEY_PORT" > .valkey-port
    echo -e "${GREEN}✓ Wrote .valkey-port ($VALKEY_PORT)${NC}\n"

    # Shell-quote WORKTREE_DIR so paths containing spaces or shell
    # metacharacters survive the source-back from .env. printf %q is
    # available on bash 3.2+ (macOS default).
    local worktree_dir_quoted
    worktree_dir_quoted=$(printf '%q' "${WORKTREE_DIR:-}")

    local effective_database_url database_url_quoted existing_worktree_dir candidate_database_url candidate_db_name
    existing_worktree_dir=$(read_existing_env_var WORKTREE_DIR)
    effective_database_url="${DATABASE_URL:-}"
    if [ -n "$effective_database_url" ] && ! worktree_resource_is_main "$(pwd -P)"; then
        candidate_db_name=$(DATABASE_URL="$effective_database_url" db_name_from_url)
        if [ "$candidate_db_name" != "$DB_NAME" ]; then
            effective_database_url=""
        fi
    fi
    if [ -z "$effective_database_url" ] && [ -n "$existing_worktree_dir" ] && [ "$existing_worktree_dir" = "${WORKTREE_DIR:-}" ]; then
        candidate_database_url=$(read_existing_env_var DATABASE_URL)
        if [ -n "$candidate_database_url" ]; then
            candidate_db_name=$(DATABASE_URL="$candidate_database_url" db_name_from_url)
            if worktree_resource_is_main "$(pwd -P)" || [ "$candidate_db_name" != "voucha" ]; then
                effective_database_url=$candidate_database_url
            fi
        fi
    fi
    if [ -z "$effective_database_url" ]; then
        effective_database_url="$(dev_db_target_default_database_url "$DB_NAME")"
    fi
    database_url_quoted=$(printf '%q' "$effective_database_url")

    # Resolve values whose configurers are gated to web mode (configure_cf_worker_secret,
    # configure_web_push_keys, configure_turnstile_keys) before .env is truncated below.
    # write_worktree_env itself now also runs in backend mode (B3), so these must always
    # end up declared — even to an intentionally empty string — rather than left unset:
    # an unset reference under `set -u` further down in this function would abort the
    # script. resolve_preserved_env_var prefers this run's own configurer output when one
    # ran, else falls back to the prior .env, so a backend-mode refresh does not drop a
    # web worktree's existing secrets, and a web re-run that intentionally clears Turnstile
    # does not resurrect a stale pair from before.
    #
    # CF_WORKER_SECRET is a special case: unlike the other five, its resolver is called
    # with a single argument, so the shell key resolve_preserved_env_var checks
    # (CF_WORKER_SECRET) is spelled identically to the name ~/voucha.env would use. The
    # gate 1186-1250 block above now sources ~/voucha.env into this top-level shell
    # unconditionally at every mode >= backend (B3), so a changed value there would
    # satisfy `declare -p` even in backend mode, even though configure_cf_worker_secret
    # (its actual configurer) never ran. Backend mode never runs write_worker_env or
    # write_web_env_local — the only other writers of this same secret
    # (cloudflare-worker/.dev.vars, web/.env.local) — so adopting a live value here alone
    # would desync .env from those untouched files and break Worker auth. Read straight
    # from the prior .env outside web mode instead of trusting resolve_preserved_env_var's
    # declare-p check. (The other five below use an internal FINAL_*/EFFECTIVE_* shell
    # key distinct from their .env name, so ~/voucha.env sourcing can never satisfy their
    # declare-p check and they are not exposed to this.)
    if [ "$MODE" = web ]; then
        CF_WORKER_SECRET=$(resolve_preserved_env_var CF_WORKER_SECRET)
    else
        CF_WORKER_SECRET=$(read_existing_env_var CF_WORKER_SECRET)
    fi
    FINAL_WEB_PUSH_PUBLIC_KEY=$(resolve_preserved_env_var FINAL_WEB_PUSH_PUBLIC_KEY WEB_PUSH_PUBLIC_KEY)
    FINAL_WEB_PUSH_PRIVATE_KEY=$(resolve_preserved_env_var FINAL_WEB_PUSH_PRIVATE_KEY WEB_PUSH_PRIVATE_KEY)
    FINAL_WEB_PUSH_SUBJECT=$(resolve_preserved_env_var FINAL_WEB_PUSH_SUBJECT WEB_PUSH_SUBJECT)
    EFFECTIVE_TURNSTILE_SITE_KEY=$(resolve_preserved_env_var EFFECTIVE_TURNSTILE_SITE_KEY NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY)
    EFFECTIVE_TURNSTILE_SECRET_KEY=$(resolve_preserved_env_var EFFECTIVE_TURNSTILE_SECRET_KEY CLOUDFLARE_TURNSTILE_SECRET_KEY)
    # NODE_EXTRA_CA_CERTS is deliberately NOT resolved here in web mode: the mkcert
    # block later in main() is web's sole writer and re-derives it fresh from a live
    # `mkcert -CAROOT` on every web run (self-healing after a reinstalled mkcert or a
    # moved cert store). Pre-seeding it here in web mode would make that block's
    # `grep -q '^export NODE_EXTRA_CA_CERTS='` guard hit and skip re-deriving, silently
    # reviving a stale path. In backend mode the mkcert block never runs at all, so we
    # do resolve/preserve it here instead — otherwise a `backend` refresh of a
    # previously-web worktree would silently drop the value.
    if [ "$MODE" != web ]; then
        NODE_EXTRA_CA_CERTS=$(resolve_preserved_env_var NODE_EXTRA_CA_CERTS)
    fi

    echo -e "${BLUE}Creating worktree .env...${NC}"
    cat > .env << EOF
# Source shared secrets
if [ -f ~/voucha.env ]; then
    set -a
    source ~/voucha.env
    set +a
fi

# Worktree-specific overrides
export NODE_ENV=development
export ENVIRONMENT=development
export PORT=$BACKEND_PORT
export DATABASE_URL=$database_url_quoted
export VALKEY_URL=redis://localhost:$VALKEY_PORT
export VALKEY_SESSION_URL=redis://localhost:$VALKEY_PORT
export VALKEY_CACHE_URL=redis://localhost:$VALKEY_PORT
export VALKEY_RATE_LIMITER_URL=redis://localhost:$VALKEY_PORT
export VALKEY_DYNAMIC_CONFIG_URL=redis://localhost:$VALKEY_PORT
export VALKEY_WORKER_QUEUE_URL=redis://localhost:$VALKEY_PORT
export VALKEY_CONTAINER=$VALKEY_CONTAINER
export NEXT_PUBLIC_API_BASE_URL=http://localhost:$BACKEND_PORT
export SITEMAP_BASE_URL=http://localhost:$WORKER_PORT
export CF_WORKER_ROUTE=http://localhost:$WORKER_PORT
export API_BASE_URL=http://localhost:$BACKEND_PORT
# Lightpanda runs as a cloud SaaS (no local binary/port); LIGHTPANDA_TOKEN is left
# unset here by default — set it yourself (e.g. via ~/voucha.env) to exercise real
# crawls locally. crawl_browser jobs throw a clear error if run without a token.
export LIGHTPANDA_CDP_URL=wss://uswest.cloud.lightpanda.io/ws
export IMAGE_ORIGIN=http://localhost:$IMAGE_LAMBDA_PORT
export NEXT_PORT=$NEXT_PORT
export STORYBOOK_PORT=$STORYBOOK_PORT
export WORKER_PORT=$WORKER_PORT
export IMAGE_LAMBDA_PORT=$IMAGE_LAMBDA_PORT
export INSPECTOR_PORT=$INSPECTOR_PORT
export WORKTREE_DIR=$worktree_dir_quoted

case " \${NODE_OPTIONS:-} " in
    *" --disable-warning=DEP0205 "*) ;;
    *) export NODE_OPTIONS="\${NODE_OPTIONS:+\$NODE_OPTIONS }--disable-warning=DEP0205" ;;
esac
EOF

    {
        # CF_WORKER_SECRET and the WEB_PUSH_* triple are configured web-only; omit them
        # entirely (via append_env_var_value) rather than write an empty export when this
        # run never configured them and no prior run left one to preserve — e.g. a truly
        # fresh backend-only worktree.
        append_env_var_value CF_WORKER_SECRET "$CF_WORKER_SECRET"
        printf 'export API_KEY_CHECKSUM_SECRET=%q\n' "$API_KEY_CHECKSUM_SECRET"
        printf 'export VOUCHA_OTP_TOKEN_HASH_SECRET=%q\n' "$VOUCHA_OTP_TOKEN_HASH_SECRET"
        printf 'export VOUCHA_STORED_SECRET_ENCRYPTION_KEYS=%q\n' "$VOUCHA_STORED_SECRET_ENCRYPTION_KEYS"
        append_s3_credentials_to_env
        append_env_var_value WEB_PUSH_PUBLIC_KEY "$FINAL_WEB_PUSH_PUBLIC_KEY"
        append_env_var_value WEB_PUSH_PRIVATE_KEY "$FINAL_WEB_PUSH_PRIVATE_KEY"
        append_env_var_value WEB_PUSH_SUBJECT "$FINAL_WEB_PUSH_SUBJECT"
        printf 'export NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=%q\n' "$FINAL_WEB_PUSH_PUBLIC_KEY"
        # Web mode never resolves NODE_EXTRA_CA_CERTS above (see comment there), so it is
        # left entirely to the later mkcert block, which appends it after deriving CAROOT.
        if [ "$MODE" != web ]; then
            append_env_var_value NODE_EXTRA_CA_CERTS "$NODE_EXTRA_CA_CERTS"
        fi
        # Turnstile: only write a real pair when both env vars are set in the shared shell.
        # When unset, code-level defaults in web/lib/turnstile-config.ts and
        # backend/services/captcha/verify.mts use Cloudflare's public always-pass test keys.
        if [ -n "${EFFECTIVE_TURNSTILE_SITE_KEY:-}" ] && [ -n "${EFFECTIVE_TURNSTILE_SECRET_KEY:-}" ]; then
            printf 'export CLOUDFLARE_TURNSTILE_SECRET_KEY=%q\n' "$EFFECTIVE_TURNSTILE_SECRET_KEY"
            printf 'export NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=%q\n' "$EFFECTIVE_TURNSTILE_SITE_KEY"
        fi
    } >> .env

    echo -e "${GREEN}✓ Created .env${NC}\n"
}

write_worker_env() {
    echo -e "${BLUE}Generating cloudflare-worker/.dev.vars...${NC}"

    # Playwright and local dev builds serve Next.js static assets from the Next.js
    # server origin even when pages are loaded through the HTTPS CF Worker.
    local csp_asset_origin="http://localhost:$NEXT_PORT"

    cat > cloudflare-worker/.dev.vars << EOF
BACKEND_ORIGIN=http://localhost:$BACKEND_PORT
WEB_ORIGIN=http://localhost:$NEXT_PORT
CSP_ASSET_ORIGIN=$csp_asset_origin
CSP_BROWSER_UPLOAD_ORIGINS=["https://$S3_BUCKET_IMAGE_UPLOADS.s3.us-west-2.amazonaws.com","https://$S3_BUCKET_IMAGE_UPLOADS.s3.dualstack.us-west-2.amazonaws.com"]
CF_WORKER_SECRET="$CF_WORKER_SECRET"
# Local-only Next.js HMR support. The worker rejects WebSocket upgrades when
# PRODUCTION=true or WEB_ORIGIN is not localhost/127.0.0.1/[::1].
DEV_WEBSOCKET_PROXY=true
PRODUCTION=false

# Optional override for real app JWT verification keys in local worker dev.
# Omit this in normal dev/test to use the shared fallback test key.
# VOUCHA_SESSION_JWT_PUBLIC_KEYS_B64=<base64-encoded JSON array of public JWKs>
EOF
    echo -e "${GREEN}✓ Generated cloudflare-worker/.dev.vars${NC}\n"
}

write_web_env_local() {
    echo -e "${BLUE}Updating web/.env.local...${NC}"
    mkdir -p web

    local cert_dir="dev/certs"
    local asset_prefix
    if [ -f "$cert_dir/localhost.pem" ] && [ -f "$cert_dir/localhost-key.pem" ]; then
        # With mkcert the page is served over HTTPS from the CF Worker; assets must use
        # the same HTTPS origin to avoid mixed-content blocks. The Worker proxies
        # _next/static/* to the Next.js dev server.
        asset_prefix="https://localhost:$WORKER_PORT"
    else
        # Without mkcert assets load directly from Next.js (HTTP, no mixed-content risk).
        asset_prefix="http://localhost:$NEXT_PORT"
    fi

    cat > web/.env.local << EOF
NEXT_PUBLIC_API_BASE_URL=http://localhost:$BACKEND_PORT
API_BASE_URL=http://localhost:$BACKEND_PORT
NEXT_PUBLIC_META_APP_ID=${META_APP_ID:-}
NEXT_PUBLIC_FACEBOOK_APP_ID=${FACEBOOK_APP_ID:-}
SITEMAP_BASE_URL=http://localhost:$WORKER_PORT
NEXT_PUBLIC_ASSET_PREFIX=$asset_prefix
# Browser hits the local image-resize Lambda directly. In production, IMAGE_ORIGIN
# is set per-environment on the ECS task definition (no NEXT_PUBLIC_ prefix so the
# same Docker image deploys to staging and production); the root layout mirrors it
# to window.__IMAGE_ORIGIN__ for client components.
IMAGE_ORIGIN=http://localhost:$IMAGE_LAMBDA_PORT
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=$FINAL_WEB_PUSH_PUBLIC_KEY
EOF
    # Append secrets separately so the heredoc doesn't need to handle special characters
    printf 'CF_WORKER_SECRET="%s"\n' "$CF_WORKER_SECRET" >> web/.env.local
    # Always write the Turnstile site key — defaults to Cloudflare's public always-pass test key
    # when no real value is sourced from ~/voucha.env. web/next.config.ts asserts this env var
    # is set during `phase-production-build` (which next typegen also runs under), so writing the
    # test key keeps `pnpm run typecheck:web` working on a fresh local setup. Whenever the value
    # being written is any of Cloudflare's public test site keys (default OR sourced from
    # ~/voucha.env), also write ALLOW_TURNSTILE_TEST_KEY=true so the build guard does not reject
    # the test key as a misconfigured production deploy. Keep this list in sync with
    # TURNSTILE_TEST_SITE_KEYS in web/lib/turnstile-config.ts.
    local turnstile_site_key="${EFFECTIVE_TURNSTILE_SITE_KEY:-1x00000000000000000000AA}"
    printf 'NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=%s\n' "$turnstile_site_key" >> web/.env.local
    case "$turnstile_site_key" in
        1x00000000000000000000AA | 2x00000000000000000000AB | 1x00000000000000000000BB | 2x00000000000000000000BB | 3x00000000000000000000FF)
            printf 'ALLOW_TURNSTILE_TEST_KEY=true\n' >> web/.env.local
            ;;
    esac
    echo -e "${GREEN}✓ Updated web/.env.local${NC}\n"
}

database_has_migrations_table() {
    local database_url=$1

    psql "$database_url" -Atqc "
        SELECT CASE
          WHEN to_regclass('migrations') IS NOT NULL THEN 't'
          ELSE 'f'
        END
    "
}

reset_database_if_schema_mismatch() {
    local database_url migrations_table_exists stale_schema_reason

    if [ "${IS_MAIN:-false}" = true ]; then
        return 0
    fi

    database_url="${DATABASE_URL:-$(dev_db_target_default_database_url "$DB_NAME")}"
    (
        unset PGHOST PGHOSTADDR PGPORT PGUSER PGPASSWORD PGSERVICE PGSERVICEFILE PGTARGETSESSIONATTRS
        unset PGSSLMODE PGSSLCERT PGSSLKEY PGSSLROOTCERT PGSSLCRL PGSSLCRLDIR
        dev_db_target_resolve reset "$database_url" "$DB_NAME"
        dev_db_target_export_pg_env
        if ! dev_db_target_local_or_allowed reset; then
            echo -e "${YELLOW}Skipping automatic stale schema reset for non-local database target; set VOUCHA_ALLOW_NON_LOCAL_DB_RESET=1 to allow it.${NC}"
            exit 0
        fi

        migrations_table_exists=$(database_has_migrations_table "$database_url")

        if [ "$migrations_table_exists" != "t" ]; then
            exit 0
        fi

        stale_schema_reason=$(detect_stale_schema_reason "$database_url")

        if [ -z "$stale_schema_reason" ]; then
            exit 0
        fi

        echo -e "${YELLOW}Detected stale $DEV_DB_TARGET_DB_NAME schema: $stale_schema_reason; resetting database before migrations${NC}"

        dropdb "$DEV_DB_TARGET_DB_NAME"
        createdb "$DEV_DB_TARGET_DB_NAME"
        echo -e "${GREEN}✓ Reset database $DEV_DB_TARGET_DB_NAME${NC}"
    )
}

print_unsupported_database_target_error() {
    local variable_name=$1

    echo -e "${RED}Error: $variable_name cannot select the Voucha worktree database.${NC}" >&2
    echo "Set DATABASE_URL explicitly so ./dev/initialize and the application use the same target." >&2
}

validate_worktree_database_target() {
    local connection_variable connection_value existing_worktree_dir

    for connection_variable in PGHOST PGHOSTADDR PGPORT PGSERVICE PGSERVICEFILE; do
        connection_value="${!connection_variable-}"
        if [ -n "$connection_value" ]; then
            print_unsupported_database_target_error "$connection_variable"
            return 1
        fi
    done

    existing_worktree_dir=$(read_existing_env_var WORKTREE_DIR)
    if [ -n "$existing_worktree_dir" ] && [ "$existing_worktree_dir" = "${WORKTREE_DIR:-}" ]; then
        for connection_variable in PGHOST PGHOSTADDR PGPORT PGSERVICE PGSERVICEFILE; do
            connection_value=$(read_existing_env_var "$connection_variable")
            if [ -n "$connection_value" ]; then
                print_unsupported_database_target_error "$connection_variable"
                return 1
            fi
        done
    fi
}

prepare_worktree_database_host() {
    # mode defaults to "web" (rather than reading the caller's $MODE) so this
    # function's hint text is deterministic when unit-tested standalone,
    # outside of main()'s call frame. Real callers pass "$MODE" explicitly.
    local mode="${1:-web}"
    local existing_database_url existing_worktree_dir existing_db_name

    validate_worktree_database_target || return 1

    if [ -n "${DATABASE_URL:-}" ] && [ -n "${DB_NAME:-}" ] && ! worktree_resource_is_main "$(pwd -P)"; then
        if [ "$(DATABASE_URL="$DATABASE_URL" db_name_from_url)" != "$DB_NAME" ]; then
            unset DATABASE_URL
        fi
    fi

    [ -z "${DATABASE_URL:-}" ] || return 0

    existing_worktree_dir=$(read_existing_env_var WORKTREE_DIR)
    if [ -n "$existing_worktree_dir" ] && [ "$existing_worktree_dir" = "${WORKTREE_DIR:-}" ]; then
        existing_database_url=$(read_existing_env_var DATABASE_URL)
        if [ -n "$existing_database_url" ]; then
            existing_db_name=$(DATABASE_URL="$existing_database_url" db_name_from_url)
            if worktree_resource_is_main "$(pwd -P)" || [ "$existing_db_name" != "voucha" ]; then
                if [ "$existing_database_url" != "$(dev_db_target_default_database_url "$DB_NAME")" ]; then
                    return 0
                fi
            fi
        fi
    fi

    [ "$(uname -s)" = Darwin ] || return 0

    if ! command -v brew >/dev/null 2>&1; then
        echo -e "${RED}Error: Homebrew is required to start the default local PostgreSQL service.${NC}" >&2
        echo "Provision the host with https://github.com/vouchington/vouchington-machines and rerun './dev/initialize $mode'." >&2
        return 1
    fi

    echo -e "${BLUE}Starting local PostgreSQL service...${NC}"
    if ! brew services start postgresql@18; then
        echo -e "${RED}Error: Failed to start Homebrew PostgreSQL 18.${NC}" >&2
        echo "Run 'brew services info postgresql@18' for details, fix the service, and rerun './dev/initialize $mode'." >&2
        return 1
    fi
    echo ""
}

ensure_database_exists() {
    # See prepare_worktree_database_host for why mode defaults to "web" here
    # instead of reading $MODE.
    local mode="${1:-web}"
    echo -e "${BLUE}Creating PostgreSQL database: $DB_NAME...${NC}"
    local psql_err_file="${TMPDIR:-/tmp}/psql-list-err-${USER:-$(id -u)}-$$.txt"
    local createdb_err_file="${TMPDIR:-/tmp}/createdb-err-${USER:-$(id -u)}-$$.txt"
    dev_db_target_resolve init "${DATABASE_URL:-}" "$DB_NAME"
    DB_NAME="$DEV_DB_TARGET_DB_NAME"
    dev_db_target_export_pg_env
    if ! dev_db_target_local_or_allowed init; then
        echo -e "${RED}Error: Refusing to initialize non-local database $DB_NAME.${NC}"
        echo "Set VOUCHA_ALLOW_NON_LOCAL_DB_INIT=1 to allow this explicitly."
        rm -f "$psql_err_file" "$createdb_err_file"
        exit 1
    fi

    if ! psql --dbname=postgres -lqt 2>"$psql_err_file" | cut -d \| -f 1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -Fqx -- "$DB_NAME"; then
        if grep -q "No such file\|Connection refused\|could not connect" "$psql_err_file" 2>/dev/null; then
            print_database_connection_error "$mode"
            rm -f "$psql_err_file" "$createdb_err_file"
            exit 1
        fi
        if ! createdb "$DB_NAME" 2>"$createdb_err_file"; then
            if grep -q "No such file\|Connection refused\|could not connect" "$createdb_err_file" 2>/dev/null; then
                print_database_connection_error "$mode"
            fi
            cat "$createdb_err_file" >&2
            rm -f "$psql_err_file" "$createdb_err_file"
            exit 1
        fi
        echo -e "${GREEN}✓ Created database $DB_NAME${NC}"
    else
        echo -e "${YELLOW}Database $DB_NAME already exists, skipping creation${NC}"
    fi
    rm -f "$psql_err_file" "$createdb_err_file"
    echo ""
}

print_usage() {
    echo "Usage: ./dev/initialize [monorepo|backend|web]"
    echo ""
    echo "  monorepo  Install deps and pinned tooling — no Docker, DB, or .env"
    echo "            Enables: oxlint, oxfmt, no-mistakes, unit tests (vitest)"
    echo "  backend   monorepo + ports, Valkey, DB, migrations, .env — no HTTPS certs"
    echo "            or CF Worker/web-only secrets"
    echo "            Enables: monorepo + DB/Valkey-backed tests"
    echo "  web       Full setup: backend + HTTPS certs, CF Worker env, web/.env.local (default)"
    echo "            Enables: all services via ./dev/tmux, Playwright tests"
    echo ""
    echo "Bare './dev/initialize' defaults to 'web'."
}

print_docker_daemon_error() {
    # mode defaults to "web" (rather than reading the caller's $MODE) so this
    # function's hint text is deterministic when unit-tested standalone,
    # outside of main()'s call frame — an ambient $MODE (e.g. Vitest sets one)
    # would otherwise leak into the message. Real callers pass "$MODE".
    local mode="${1:-web}"
    echo -e "${RED}Error: Docker daemon is not reachable or not running.${NC}"
    echo -e "${YELLOW}If Docker Desktop is stopped, start it and try again.${NC}"
    echo -e "${YELLOW}If Docker is already running, rerun ./dev/initialize $mode without sandboxing.${NC}"
}

print_database_connection_error() {
    # See print_docker_daemon_error for why mode defaults to "web" here
    # instead of reading $MODE.
    local mode="${1:-web}"
    echo -e "${RED}Error: PostgreSQL connection failed.${NC}"
    if [ "$(uname -s)" = Darwin ] && command -v brew >/dev/null 2>&1; then
        echo -e "${YELLOW}Check 'brew services info postgresql@18' and confirm that the configured database target is reachable.${NC}"
    else
        echo -e "${YELLOW}Confirm that the host PostgreSQL 18 service is running and the configured database target is reachable.${NC}"
    fi
    echo -e "${YELLOW}Inspect DATABASE_URL in .env, correct its host or port if needed, then retry: source .env && ./dev/initialize $mode${NC}"
}

# Ranks the three-rung initialization ladder so callers can compare modes
# without string-matching every pair. Unknown/empty input (e.g. a missing
# .initialized file, or a marker predating this ladder) ranks lowest so it
# never outranks a real requested mode.
initialization_mode_rank() {
    case "$1" in
        monorepo) printf '%s' 1 ;;
        backend) printf '%s' 2 ;;
        web) printf '%s' 3 ;;
        *) printf '%s' 0 ;;
    esac
}

# True (exit 0) when $1's rung is at or above $2's on the ladder.
mode_at_least() {
    local mode_rank floor_rank
    mode_rank=$(initialization_mode_rank "$1")
    floor_rank=$(initialization_mode_rank "$2")
    [ "$mode_rank" -ge "$floor_rank" ]
}

# Probes the worktree on disk (not the requested mode) for the strongest
# capability its current .env/artifacts actually support: web only when the
# stricter web validator passes (matching ports across .env, .dev.vars, and
# web/.env.local), else backend when the backend validator passes, else
# monorepo. Always exits 0 itself — the validators' own subshell-sourcing of
# .env must never leak into, or abort, the caller under `set -e`, so run this
# only inside a command substitution (e.g. `x=$(worktree_validated_capability ...)`).
worktree_validated_capability() {
    local repo_root=$1

    if worktree_resource_validate_web_init "$repo_root"; then
        printf '%s' web
        return 0
    fi
    if worktree_resource_validate_backend_init "$repo_root"; then
        printf '%s' backend
        return 0
    fi
    printf '%s' monorepo
    return 0
}

# The persisted marker is the strongest capability this run can vouch for: the
# requested mode, or a still-valid capability from a prior run — whichever
# ranks higher. The prior marker only counts up to what worktree_validated_capability
# confirms is still true on disk right now, so a marker recorded by an earlier run
# demotes once its artifacts go stale or missing (e.g. a `web` marker with a deleted
# cloudflare-worker/.dev.vars, or re-rolled web/.env.local ports) instead of being
# trusted blindly: marker = max(requested, min(existing_marker, strongest_valid_on_disk)).
persist_initialization_capability() {
    local requested_mode="$1"
    local repo_root="${2:-$REPO_ROOT}"
    local existing_capability="" strongest_on_disk
    local requested_rank existing_rank strongest_rank preserved_rank marker_rank

    if [ -f "$repo_root/.initialized" ]; then
        existing_capability="$(cat "$repo_root/.initialized")"
    fi

    strongest_on_disk=$(worktree_validated_capability "$repo_root")

    requested_rank=$(initialization_mode_rank "$requested_mode")
    existing_rank=$(initialization_mode_rank "$existing_capability")
    strongest_rank=$(initialization_mode_rank "$strongest_on_disk")

    preserved_rank=$existing_rank
    if [ "$strongest_rank" -lt "$preserved_rank" ]; then
        preserved_rank=$strongest_rank
    fi

    marker_rank=$requested_rank
    if [ "$preserved_rank" -gt "$marker_rank" ]; then
        marker_rank=$preserved_rank
    fi

    case "$marker_rank" in
        3) INITIALIZED_CAPABILITY=web ;;
        2) INITIALIZED_CAPABILITY=backend ;;
        *) INITIALIZED_CAPABILITY=monorepo ;;
    esac

    PRESERVED_CAPABILITY=""
    if [ "$marker_rank" -gt "$requested_rank" ]; then
        PRESERVED_CAPABILITY="$INITIALIZED_CAPABILITY"
    fi

    printf '%s\n' "$INITIALIZED_CAPABILITY" > "$repo_root/.initialized"
}

print_lower_mode_next_steps() {
    local requested_mode="$1"

    case "$PRESERVED_CAPABILITY" in
        web)
            echo "  Web capability remains available after this $requested_mode refresh."
            echo "  Load env:       source .env"
            echo "  Start services: ./dev/tmux"
            return
            ;;
        backend)
            echo "  Backend capability (DB + Valkey) remains available after this $requested_mode refresh."
            echo "  Run: source .env"
            echo "  Run DB/Valkey-backed tests now, or: ./dev/initialize web for the full stack."
            return
            ;;
    esac

    if [ "$requested_mode" = monorepo ]; then
        echo "  To run DB/Valkey-backed tests: ./dev/initialize backend"
    fi
    echo "  To run the full web stack: ./dev/initialize web"
}

print_mode_summary() {
    local requested_mode="$1"

    case "$requested_mode" in
        web)
            echo -e "${BLUE}Service URLs:${NC}"
            if [ -f "dev/certs/localhost.pem" ] && [ -f "dev/certs/localhost-key.pem" ]; then
                echo "  Entry point:  https://localhost:$WORKER_PORT  (open in browser)"
            else
                echo "  Entry point:  http://localhost:$WORKER_PORT  (install mkcert for HTTPS)"
            fi
            echo "  Backend API:  http://localhost:$BACKEND_PORT"
            echo "  NextJS:       http://localhost:$NEXT_PORT"
            echo "  Image Lambda: http://localhost:$IMAGE_LAMBDA_PORT"
            echo ""

            echo -e "${BLUE}Database:${NC}"
            echo "  Name:        $DB_NAME"
            echo "  URL:         $(dev_db_target_display_database_url "${DATABASE_URL:-}" "$DB_NAME")"
            echo ""

            echo -e "${BLUE}Valkey:${NC}"
            echo "  Container:   $VALKEY_CONTAINER"
            echo "  Port:        $VALKEY_PORT"
            echo "  URL:         redis://localhost:$VALKEY_PORT"
            echo ""

            echo -e "${BLUE}Next Steps:${NC}"
            echo "  1. Load env:       source .env     (this shell; DB/Valkey-backed tests need it)"
            echo "  2. Start services: ./dev/tmux      (services + assistant windows)"
            if [ -f "dev/certs/localhost.pem" ] && [ -f "dev/certs/localhost-key.pem" ]; then
                echo "  3. Open browser:   https://localhost:$WORKER_PORT"
            else
                echo "  3. Open browser:   http://localhost:$WORKER_PORT  (install mkcert for HTTPS)"
            fi
            echo "  4. Check status:   ./dev/status"
            echo ""
            ;;
        backend)
            echo -e "${BLUE}Database:${NC}"
            echo "  Name:        $DB_NAME"
            echo "  URL:         $(dev_db_target_display_database_url "${DATABASE_URL:-}" "$DB_NAME")"
            echo ""

            echo -e "${BLUE}Valkey:${NC}"
            echo "  Container:   $VALKEY_CONTAINER"
            echo "  Port:        $VALKEY_PORT"
            echo "  URL:         redis://localhost:$VALKEY_PORT"
            echo ""

            echo -e "${BLUE}Next Steps:${NC}"
            echo "  1. Run: source .env"
            echo "  2. DB/Valkey-backed tests are ready to run (no HTTPS certs or CF Worker/web-only secrets)."
            print_lower_mode_next_steps "$requested_mode"
            echo ""
            ;;
        *)
            echo -e "${GREEN}Monorepo tools ready:${NC}"
            echo "  Lint:       pnpm exec oxlint --type-aware && pnpm exec oxfmt"
            echo "  Static:     pnpm run no-mistakes"
            echo "  Unit tests: pnpm exec vitest run --project ts-shared"
            echo ""
            echo -e "${BLUE}Next Steps:${NC}"
            print_lower_mode_next_steps "$requested_mode"
            echo ""
            ;;
    esac
}

main() {
    if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
        print_usage
        exit 0
    fi
    if [ "$#" -gt 1 ]; then
        echo -e "${RED}Error: expected at most one mode.${NC}" >&2
        print_usage >&2
        exit 2
    fi
    local MODE="${1:-web}"
    case "$MODE" in
        monorepo|backend|web) ;;
        *)
            echo -e "${RED}Error: unknown mode '$1'.${NC}" >&2
            print_usage >&2
            exit 2
            ;;
    esac

    local shared_env
    local INITIALIZED_CAPABILITY=""
    local PRESERVED_CAPABILITY=""

    cd "$REPO_ROOT"

    echo -e "${BLUE}=== Voucha Worktree Initializer (mode: $MODE) ===${NC}\n"

    # ── Phase A: prerequisites for both modes ──────────────────────────────────

    if ! command -v node >/dev/null 2>&1; then
        echo -e "${RED}Error: Node.js is not available.${NC}"
        echo -e "${YELLOW}Provision the host with https://github.com/vouchington/vouchington-machines${NC}"
        echo -e "${YELLOW}Required capabilities: docs/development/system-dependencies.md${NC}"
        exit 1
    fi

    # This Bash/df gate supports bootstrap Node versions that cannot execute
    # native TypeScript and runs before nvm can download the repository version.
    if ! check_bootstrap_host_storage; then
        exit 1
    fi
    echo ""

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        echo -e "${RED}Error: Not inside a git repository${NC}"
        exit 1
    fi

    GIT_DIR=$(git rev-parse --git-dir)
    clear_stale_index_lock "$GIT_DIR"
    COMMON_CONFIG="$(git -C "$REPO_ROOT" rev-parse --git-common-dir 2>/dev/null || echo "$GIT_DIR")/config"
    heal_shared_git_config "$COMMON_CONFIG"
    "$REPO_ROOT/dev/lib/localization-merge-driver.sh" "$REPO_ROOT"

    ensure_node_version

    # Node activation makes the comprehensive TypeScript probe available. Its
    # optional pnpm/Docker discovery runs only after required probes pass.
    local storage_preflight_args=(--worktree "$REPO_ROOT" --pnpm-store)
    if mode_at_least "$MODE" backend; then
        storage_preflight_args+=(--docker-root)
    fi
    if ! node "$REPO_ROOT/dev/host-storage-preflight.mts" "${storage_preflight_args[@]}"; then
        exit 1
    fi
    echo ""

    echo -e "${BLUE}Ensuring pnpm is available...${NC}"
    if ! command -v pnpm >/dev/null 2>&1; then
        if command -v corepack >/dev/null 2>&1; then
            corepack enable pnpm
        else
            echo -e "${RED}Error: pnpm is not installed and corepack is not available.${NC}"
            echo "Install pnpm 11 or enable Corepack, then rerun ./dev/initialize $MODE."
            exit 1
        fi
    fi
    if ! command -v pnpm >/dev/null 2>&1; then
        echo -e "${RED}Error: pnpm is still unavailable after enabling Corepack.${NC}"
        echo "Install pnpm 11, then rerun ./dev/initialize $MODE."
        exit 1
    fi
    echo ""

    echo -e "${BLUE}Installing dependencies...${NC}"
    # Install before any worktree resource setup so the published worktree
    # helper is available even on a fresh, uninitialized checkout.
    # Local worktrees install bare so node_modules matches an updated lockfile
    # after a rebase/merge; CI keeps --frozen-lockfile.
    local lockfile_arg=""
    [ -n "${CI:-}" ] && lockfile_arg="--frozen-lockfile"
    retry_command 3 5 "pnpm install${CI:+ --frozen-lockfile} --config.confirmModulesPurge=false" \
        pnpm install ${lockfile_arg:+"$lockfile_arg"} \
            --config.disallow-workspace-cycles=false --config.confirmModulesPurge=false
    echo ""

    # shellcheck source=dev/lib/git-worktrees.sh
    source "$REPO_ROOT/dev/lib/git-worktrees.sh"

    IS_MAIN=false
    if worktree_resource_is_main "$REPO_ROOT"; then
        IS_MAIN=true
    elif is_disposable_checkout_path "$REPO_ROOT" && [ -d "$REPO_ROOT/.git" ]; then
        register_disposable_checkout_path "$REPO_ROOT"
    fi

    register_live_worktree_resource_paths "$REPO_ROOT"

    WORKTREE_DIR=$(worktree_resource_current_dir "$REPO_ROOT")

    # ── Phase B: backend-and-above prerequisites (Docker, DB, Valkey) ─────────

    if mode_at_least "$MODE" backend; then
        if ! command -v docker >/dev/null 2>&1; then
            echo -e "${RED}Error: Docker is not installed.${NC}"
            echo -e "${YELLOW}Provision the host with https://github.com/vouchington/vouchington-machines${NC}"
            echo -e "${YELLOW}Required capabilities: docs/development/system-dependencies.md${NC}"
            exit 1
        fi

        if ! docker info >/dev/null 2>&1; then
            print_docker_daemon_error "$MODE"
            exit 1
        fi

        if $IS_MAIN; then
            DB_NAME="voucha"
            VALKEY_CONTAINER="voucha-valkey"
        else
            DB_NAME=$(worktree_resource_owned_db_name "$REPO_ROOT")
            VALKEY_CONTAINER=$(worktree_resource_owned_valkey_container "$REPO_ROOT")
        fi

        shared_env="$HOME/voucha.env"
        owned_db_name=$DB_NAME
        owned_valkey_container=$VALKEY_CONTAINER
        if [ -f "$shared_env" ]; then
            echo -e "${GREEN}✓ Found shared secrets at $shared_env${NC}\n"
            set -a
            # shellcheck source=/dev/null
            source "$shared_env"
            set +a
        else
            echo -e "${YELLOW}Note: $shared_env not found — using current shell environment for secrets${NC}\n"
        fi
        if ! $IS_MAIN; then
            DB_NAME=$owned_db_name
            VALKEY_CONTAINER=$owned_valkey_container
            worktree_resource_acquire_operation_lock
            trap worktree_resource_release_operation_lock EXIT
        fi
        validate_worktree_database_target || exit 1

        if [ "$MODE" = web ]; then
            echo -e "${BLUE}Clearing stale dev caches...${NC}"
            clear_dev_caches "cloudflare-worker/.wrangler/state" "cloudflare-worker/.wrangler/runtime" "web/.next"
            echo ""
        fi

        assign_worktree_ports

        if $IS_MAIN; then
            echo -e "${GREEN}Detected main worktree${NC}"
        fi

        echo -e "${GREEN}Port assignments:${NC}"
        echo "  CF Worker:    $WORKER_PORT  (entry point)"
        echo "  Backend API:  $BACKEND_PORT"
        echo "  NextJS:       $NEXT_PORT"
        echo "  Image Lambda: $IMAGE_LAMBDA_PORT"
        echo "  Inspector:    $INSPECTOR_PORT"
        echo "  Valkey:       $VALKEY_PORT"
        echo ""

        if [ "$MODE" = web ]; then
            validate_s3_credentials
            configure_turnstile_keys
        fi

        ensure_valkey_container
    fi

    # ── Phase C: pinned tooling ────────────────────────────────────────────────

    echo -e "${BLUE}Checking native addon readiness...${NC}"
    node "$REPO_ROOT/dev/native-addon-readiness.mts"
    echo ""

    # Install pinned CI tool versions (ripgrep, shellcheck, selene, actionlint)
    # from .mise.toml so lint/static-analysis and pre-push run with the same
    # versions as CI. The host repository installs mise. Fall back to its common
    # ~/.local/bin location when a fresh shell has not activated that path yet.
    local mise_bin="mise"
    if ! command -v mise >/dev/null 2>&1 && [ -x "$HOME/.local/bin/mise" ]; then
        mise_bin="$HOME/.local/bin/mise"
    fi
    if command -v "$mise_bin" >/dev/null 2>&1; then
        echo -e "${BLUE}Installing pinned CI tools via mise...${NC}"
        # Trust this worktree's .mise.toml so `mise install` does not skip it on
        # mise versions that require explicit trust before parsing a config.
        "$mise_bin" trust "$REPO_ROOT/.mise.toml" >/dev/null 2>&1 || true
        if "$mise_bin" install; then
            echo -e "${GREEN}✓ mise tools ready${NC}\n"
        else
            # Non-fatal: the app and DB setup do not depend on these lint tools.
            # pre-push will surface a missing tool clearly if install genuinely failed.
            echo -e "${YELLOW}Warning: 'mise install' failed — pinned CI tools may be missing. Re-run './dev/initialize $MODE' or 'mise install' after resolving the error.${NC}\n"
        fi
    else
        echo -e "${YELLOW}Warning: mise not found — provision the host with https://github.com/vouchington/vouchington-machines${NC}\n"
        echo -e "${YELLOW}See docs/development/system-dependencies.md for required host capabilities.${NC}\n"
    fi

    if mode_at_least "$MODE" backend; then
        if [ "$MODE" = web ]; then
            configure_web_push_keys
            configure_cf_worker_secret
        fi
        configure_api_key_checksum_secret
        configure_token_storage_secrets
        prepare_worktree_database_host "$MODE"
        write_worktree_env
        if ! $IS_MAIN; then
            worktree_resource_release_operation_lock
            trap - EXIT
        fi
    fi

    # ── Phase B (continued): web-only HTTPS + worker env ──────────────────────

    if [ "$MODE" = web ]; then
        echo -e "${BLUE}Setting up HTTPS certificates...${NC}"
        local cert_dir="dev/certs"
        if [ -f "$cert_dir/localhost.pem" ] && [ -f "$cert_dir/localhost-key.pem" ]; then
            echo -e "${GREEN}✓ HTTPS certificates already exist${NC}"
        elif command -v mkcert >/dev/null 2>&1; then
            mkdir -p "$cert_dir"
            (cd "$cert_dir" && mkcert -cert-file localhost.pem -key-file localhost-key.pem localhost 127.0.0.1 ::1)
            echo -e "${GREEN}✓ Generated HTTPS certificates${NC}"
        else
            echo -e "${YELLOW}Warning: mkcert not installed — CF Worker will serve HTTP only${NC}"
            echo -e "${YELLOW}Provision the host with https://github.com/vouchington/vouchington-machines${NC}"
            echo -e "${YELLOW}Required capabilities: docs/development/system-dependencies.md${NC}"
        fi
        # When mkcert certs exist, Node.js (used by playwright's webServer URL polling)
        # must trust the mkcert CA or HTTPS readiness checks fail with
        # UNABLE_TO_VERIFY_LEAF_SIGNATURE. NODE_EXTRA_CA_CERTS tells Node.js to trust it.
        if [ -f "$cert_dir/localhost.pem" ] && command -v mkcert >/dev/null 2>&1; then
            local mkcert_ca_root
            mkcert_ca_root="$(mkcert -CAROOT)"
            if [ -f "$mkcert_ca_root/rootCA.pem" ] && ! grep -q '^export NODE_EXTRA_CA_CERTS=' .env 2>/dev/null; then
                printf 'export NODE_EXTRA_CA_CERTS=%q\n' "$mkcert_ca_root/rootCA.pem" >> .env
                echo -e "${GREEN}✓ Added NODE_EXTRA_CA_CERTS to .env (mkcert root CA)${NC}"
            fi
        fi
        echo ""

        write_worker_env
    fi

    # ── Phase B (continued): backend-and-above database + migrations ─────────

    if mode_at_least "$MODE" backend; then
        set -a
        # shellcheck source=/dev/null
        source .env
        set +a
        url_db_name=$(db_name_from_url)
        if [ -n "$url_db_name" ]; then
            DB_NAME="$url_db_name"
        fi
        ensure_database_exists "$MODE"

        echo -e "${BLUE}Running database migrations...${NC}"
        reset_database_if_schema_mismatch
        set -a
        # shellcheck source=/dev/null
        source .env
        set +a
        (cd backend && pnpm run db:migrate)
        echo ""

        if [ "$MODE" = web ]; then
            write_web_env_local
        fi
    fi

    # ── Write init marker ──────────────────────────────────────────────────────

    clear_stale_index_lock "$GIT_DIR"
    persist_initialization_capability "$MODE"

    # ── Summary ────────────────────────────────────────────────────────────────

    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}✓ Worktree initialization complete!${NC}"
    echo -e "${GREEN}========================================${NC}\n"

    echo -e "${BLUE}Worktree Details:${NC}"
    echo "  Directory:   ${WORKTREE_DIR:-$(basename "$(pwd -P)")}"
    echo "  Branch:      $(git branch --show-current)"
    echo "  Requested:   $MODE"
    echo "  Capability:  $INITIALIZED_CAPABILITY"
    echo ""

    print_mode_summary "$MODE"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
