{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@voucha/types": [
        "../backend/types/index.mts"
      ],
      "@voucha/types/*": [
        "../backend/types/*.mts"
      ],
      "@ts-shared/data-points": [
        "../ts-shared/data-points/index.mts"
      ],
      "@ts-shared/languages": [
        "../ts-shared/languages/index.mts"
      ],
      "@ts-shared/languages/*": [
        "../ts-shared/languages/*.mts"
      ],
      "@ts-shared/route-classification": [
        "../ts-shared/route-classification/index.mts"
      ],
      "@ts-shared/route-classification/*": [
        "../ts-shared/route-classification/*.mts"
      ],
      "@ts-shared/session-jwt": [
        "../ts-shared/session-jwt/index.mts"
      ],
      "@ts-shared/session-jwt/*": [
        "../ts-shared/session-jwt/*.mts"
      ],
      "@ts-shared/ui-messages": [
        "../ts-shared/ui-messages/index.mts"
      ],
      "@ts-shared/ui-messages/*": [
        "../ts-shared/ui-messages/*.mts"
      ],
      "@ts-shared/url-signing": [
        "../ts-shared/url-signing/index.mts"
      ],
      "@ts-shared/url-signing/*": [
        "../ts-shared/url-signing/*.mts"
      ],
      "@ts-shared/utils": [
        "../ts-shared/utils/index.mts"
      ],
      "@ts-shared/utils/*": [
        "../ts-shared/utils/*.mts"
      ],
      "@ts-shared/*": [
        "../ts-shared/*"
      ]
    },
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
