{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "extends": ["../.oxlintrc.json", "../.oxlintrc.react.json"],
  // "extends" does not inherit the root "plugins" array — keep this in exact sync with it. See
  // docs/development/quality/static-code-analysis/README.md nested .oxlintrc.json section for why.
  "plugins": [
    "react",
    "nextjs",
    "jsx-a11y",
    "react-perf",
    "vitest",
    "jest",
    "promise",
    "oxc",
    "typescript",
    "unicorn",
    "import",
    "node"
  ],
  "overrides": [
    {
      // Policy: Test fixtures and helpers intentionally model unchecked external and malformed data.
      "files": [
        "**/*.test.{mts,ts,tsx}",
        "**/*.spec.{mts,ts,tsx}",
        "**/__tests__/**/*.{mts,ts,tsx}",
        "**/test-helpers/**"
      ],
      "rules": {
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    }
  ]
}
