{
  "extends": "../backend/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "erasableSyntaxOnly": false,
    "rootDir": ".",
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "types": ["node"],
    "tsBuildInfoFile": "../node_modules/.cache/email-templates-pnpm.tsbuildinfo"
  },
  "include": ["**/*.tsx", "**/*.mts", "**/*.d.ts"],
  "exclude": ["../node_modules", "dist"]
}
