#!/bin/sh
[ "${GITHUB_ACTIONS:-}" = "true" ] && exit 0
# Keep node_modules in sync after a rebase pulls an updated lockfile (issue #5269).
[ "$1" = "rebase" ] || exit 0
git rev-parse --verify -q ORIG_HEAD >/dev/null || exit 0
if git diff --name-only ORIG_HEAD HEAD \
  | grep -Eq '(^|/)(pnpm-lock\.yaml|package\.json|pnpm-workspace\.yaml)$'; then
  echo "post-rewrite: dependency manifest changed during rebase — running pnpm install"
  command -v pnpm >/dev/null 2>&1 || { printf 'post-rewrite: pnpm not on PATH — skipping install\n' >&2; exit 0; }
  pnpm install --silent || printf 'post-rewrite: WARNING — pnpm install failed (exit %s). Run it manually.\n' "$?" >&2
fi
