#!/bin/sh
[ "${GITHUB_ACTIONS:-}" = "true" ] && exit 0
# Keep node_modules in sync after `git pull` (merge strategy) pulls an updated lockfile (issue #5269).
git rev-parse --verify -q ORIG_HEAD >/dev/null || exit 0
if git diff --name-only ORIG_HEAD HEAD \
  | grep -Eq '(^|/)(pnpm-lock\.yaml|package\.json|pnpm-workspace\.yaml)$'; then
  echo "post-merge: dependency manifest changed during merge — running pnpm install"
  command -v pnpm >/dev/null 2>&1 || { printf 'post-merge: pnpm not on PATH — skipping install\n' >&2; exit 0; }
  pnpm install --silent || printf 'post-merge: WARNING — pnpm install failed (exit %s). Run it manually.\n' "$?" >&2
fi
