#!/bin/sh
[ "${GITHUB_ACTIONS:-}" = "true" ] && exit 0
# Keep node_modules in sync after `git pull` (merge strategy) pulls an updated lockfile (issue #5269).
if git rev-parse --verify -q ORIG_HEAD >/dev/null \
  && git diff --name-only ORIG_HEAD HEAD \
  | grep -Eq '(^|/)(pnpm-lock\.yaml|package\.json|pnpm-workspace\.yaml)$'; then
  echo "post-merge: dependency manifest changed during merge — running pnpm install"
  if command -v pnpm >/dev/null 2>&1; then
    install_started=$(date +%s)
    if pnpm install; then
      printf 'post-merge: pnpm install completed in %ss\n' "$(( $(date +%s) - install_started ))"
    else
      install_status=$?
      printf 'post-merge: WARNING — pnpm install failed (exit %s) after %ss. Run it manually.\n' "$install_status" "$(( $(date +%s) - install_started ))" >&2
    fi
  else
    printf 'post-merge: pnpm not on PATH — skipping install\n' >&2
  fi
fi
