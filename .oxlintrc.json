    "oxc/no-async-await": "off",
    // oxc/no-async-endpoint-handlers assumes raw Express-style route handlers where an
    // unhandled rejection in an async handler crashes the process; the rule's own docs say to
    // disable it under Express 5 (or equivalent) rejection-safety guarantees. This repo's
    // first-party @jongleberry/api-server framework already wraps every route handler in a
    // try/catch (application.mjs's `runRequest` awaits the handler inside a try/catch — not
    // router.mjs's `wrapHandler`, which only invokes it) plus a top-level
    // .catch() safety net around runRequest() itself, so async endpoint handlers can never
    // produce an unhandled rejection here. The rule's AST heuristic also only matches named
    // function declarations passed by reference (e.g. `.get(handleFoo)`), not the far more
    // common inline-arrow pattern (`.get(async (ctx) => {...})`) used elsewhere in
    // backend/api/**, so it does not even apply consistently. Verified empirically via
    // --print-config plus a full-repo run (2 files / 8 sites flagged:
    // backend/api/v1/my/communities.mts, backend/api/v1/my/landing-pages.mts). Explicitly "off"
    // (not just removed) because the oxc plugin default for this rule is "error", so an absent
    // entry would silently re-enable it.
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-barrel-file": "error",
    "oxc/no-const-enum": "error",
