        "**/__tests__/**/*.{mts,ts,tsx}",
        "**/test-helpers/**"
      ],
      "rules": {
        "no-void": "off",
        "no-await-in-loop": "off",
        "react/jsx-no-target-blank": "off",
        "nextjs/no-html-link-for-pages": "off"
      }
    }
  ]
}
