{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "ignorePatterns": [
    "**/.agents/skills/**",
    "**/.claude/skills/**",
    "**/.pr-shepherd/**",
    "!**/.pr-shepherd/**/__tests__/**"
  ],
  "plugins": ["react", "nextjs", "jsx-a11y", "react-perf", "vitest", "jest", "promise", "oxc"],
  "jsPlugins": [
    "eslint-plugin-playwright",
    {
      "name": "react-doctor",
      "specifier": "oxlint-plugin-react-doctor"
    },
    "eslint-plugin-react-you-might-not-need-an-effect",
    {
      "name": "no-mistakes",
      "specifier": "eslint-plugin-no-mistakes"
    },
    {
      "name": "voucha",
      "specifier": "./static-code-analysis/oxlint-plugin.cjs"
    },
    {
      "name": "vouchington",
      "specifier": "eslint-plugin-vouchington"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": true
