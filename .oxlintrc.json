    // These upstream Style rules are deliberate opt-outs (policy from the Plan in #9480), not
    // remediation backlogs. Do not delete these entries: the promise plugin's default severity
    // is "error", so removing an entry silently re-enables the rule repo-wide.
    // Counts come from a full type-aware run on 2026-08-17.
    "promise/avoid-new": "off", // 466 findings / 319 files
    "promise/no-nesting": "off", // 18 findings / 11 files
    "promise/param-names": "off", // 71 findings / 50 files
    "promise/prefer-await-to-callbacks": "off", // 253 findings / 152 files
    "promise/prefer-await-to-then": "off", // 755 findings / 344 files
    // These correctness-focused rules remain staged here as their linked remediations land.
    // CI uses --deny-warnings, so each rule must move directly from "off" to "error".
    // Do not delete staged entries: removal silently re-enables the plugin-default severity.
    "promise/no-multiple-resolved": "error", // #9482 remediation landed in #9506
    "promise/catch-or-return": ["error", { "allowFinally": true }], // #9483: 3 findings / 3 files (2 fixed, 1 suppressed in serve-runtime.mts)
    "promise/always-return": ["error", { "ignoreLastCallback": true }], // #9484: 27 remediated findings / 13 files — oxlint exempts a callback only when its .then() result is unused; stored/returned observation promises still need an explicit return
    "promise/no-return-in-finally": "error",
    // Kept at "error" repo-wide: only 1 pre-existing file (dev/verify-workflow-secrets-concurrency.
    // test.mts, 3 call sites) is exempted, via an inline `oxlint-disable-next-line
    // promise/no-return-wrap` comment at each site, instead of a blanket "off", so new violations
    // elsewhere still fail CI.
    "promise/no-return-wrap": "error",
    // Kept at "error" repo-wide: only 1 pre-existing file (backend/worker-runtime/serve-runtime.mts)
    // is exempted, via an inline `oxlint-disable-next-line` comment at that call site, instead of a
    // blanket "off".
    "promise/prefer-catch": "error",
    "promise/spec-only": "error",
    // Plugin-default "error"; only 5 pre-existing files, all reviewed fire-and-forget/event-handler
    // patterns, are exempted via an inline `oxlint-disable-next-line promise/no-promise-in-callback`
    // comment at each call site, instead of a blanket "off".
    "promise/no-promise-in-callback": "error",
    // Plugin-default "error"; only 1 pre-existing file (backend/data-stores/graceful-shutdown/
