{
  "format": ["typescript", "tsx", "javascript", "sql", "bash", "css"],
  "crossFormats": "typescript,tsx",
  "failOnEmpty": true,
  "similarity": 0.85,
  "minLines": 50,
  "exitCode": 1,
  "deadCode": {
    "categories": [
      "unused-file",
      "unused-export",
      "unused-symbol",
      "unused-import",
      "unused-member"
    ],
    "minConfidence": 70,
    "frameworks": [
      {
        "name": "react-error-boundary",
        "detect": {
          "dependencies": ["react"]
        },
        "globals": [
          {
            "names": ["getDerivedStateFromError"],
            "files": ["components/ui/error-boundary.tsx"]
          }
        ]
      }
    ],
    "entry": [
      "backend/data-stores/psql/config-driven/*.mts",
      "backend/entrypoints/api/executable.mts",
      "backend/entrypoints/api/verify-ipv6-egress.mts",
      "backend/entrypoints/worker-cpu/executable.mts",
      "backend/entrypoints/worker-io/executable.mts",
      "backend/entrypoints/worker-cpu/serve.mts",
      "backend/modules/structured-decisions/benchmark.mts",
      "backend/scripts/backfill-rss-feed-item-source-publications.mts",
      "backend/scripts/classifier-call-efficiency.mts",
      "backend/scripts/explain-analyze/media-delivery-replay.mts",
      "backend/scripts/explain-analyze/pruning/migration-control-child.mts",
      "backend/scripts/lookup-copyright-email-intakes.mts",
      "backend/scripts/seed-source/run.mts",
      "backend/types/lib-dom-absent.mts",
      "ci/validate-vitest-cli-timeouts.mts",
      "dev/agent-issue-labels/batch-issues.mts",
      "dev/localization/local-catalog.mts",
      "dev/localization/local-smoke.mts",
      "dev/native-addon-readiness.mts",
      "dev/otel-register.mts",
      "static-code-analysis/repo-file-policy-worker.mts",
      "web/generate-membership-benefit-catalog.ts",
      "web/storybook/mocks/contribute-cta-aside.tsx",
      "web/storybook/mocks/get-resolved-ui-locale.ts",
      "web/storybook/mocks/get-translations.ts",
      "web/storybook/mocks/languages.ts",
      "web/storybook/mocks/load-server-messages.ts",
      "web/storybook/mocks/upgrade-membership-aside.tsx",
      "web/test-helpers/vitest.setup.fake-timer-guard.mts",
      "web/test-helpers/vitest.setup.storybook-browser-guard.mts",
      "dev/sandbox-command-audit/rules.mts",
      "dev/launch-services.mts",
      "scripts/admin/import-rss-feeds.mts"
    ]
  },
  "ignore": [
    "**/migrations/**",
    "**/fixtures/**",
    "**/route-selectors.generated.mts",
    "**/bank-account-fields.tsx",
    "**/credit-card-fields.tsx",
    "**/backend/test-helpers/bedrock-router-owned-fixtures.mts",
    "**/backend/test-helpers/entities/_bedrock-embeddings-support.mts",
    "**/backend/test-helpers/entities/bedrock-embeddings-batches.mts",
    "**/backend/test-helpers/bedrock-legacy-*.mts",
    "**/backend/queues/bedrock-embeddings-batch/enqueues.real-glide.mock.test.mts",
    "**/backend/queues/bedrock-embeddings/enqueues/single-backlog.mts",
    "**/backend/services/bedrock-embeddings-batch/__tests__/utils.test.mts",
    "**/backend/services/bedrock-embeddings-batch/entities/images.mts",
