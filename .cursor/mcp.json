{
  "mcpServers": {
    "vouchington-tooling": {
      "command": "bash",
      "args": ["-c", "exec \"$(git rev-parse --show-toplevel)/node_modules/.bin/vouchington\" mcp"],
      "env": {
        "AGENT_BLACKBOARD_URL": "${env:AGENT_BLACKBOARD_URL}",
        "AGENT_BLACKBOARD_TOKEN": "${env:AGENT_BLACKBOARD_TOKEN}"
      }
    }
  }
}
