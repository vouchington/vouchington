{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node dev/cursor-hooks/session-start.mts",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node dev/cursor-hooks/before-shell.mts",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node dev/cursor-hooks/after-file-edit.mts",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "dev/tmux-agent-reminder user-prompt",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node dev/cursor-hooks/post-tool.mts",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "dev/tmux-agent-reminder pre-compact",
        "timeout": 10
      }
    ]
  }
}
