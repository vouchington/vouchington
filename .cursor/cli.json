      "Read(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Write(~/.gitconfig)",
      "Read(~/.git-credentials)",
      "Write(~/.git-credentials)",
      "Read(~/.aws/**)",
      "Write(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  }
}
