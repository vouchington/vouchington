{
  "permissions": {
    "allow": [
      "Shell(pnpm)",
      "Shell(git)",
      "Shell(gh)",
      "Shell(node)",
      "Shell(cargo)",
      "Shell(docker)",
      "Shell(npx)",
      "Shell(pr-shepherd)",
      "Shell(no-mistakes)",
      "Shell(rustfmt)",
      "Shell(selene)",
      "Shell(tmux)",
      "Shell(mise)",
      "Shell(jq)"
