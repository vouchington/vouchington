prefix_rule(pattern=["./dev/rebase-onto-main"], decision="allow")
prefix_rule(pattern=["./dev/reset-worktree"], decision="allow")
prefix_rule(pattern=["./dev/teardown"], decision="allow")
prefix_rule(pattern=["./dev/cleanup"], decision="allow")
prefix_rule(pattern=["./dev/unstick-locks"], decision="allow")
prefix_rule(pattern=["./dev/valkey-logs"], decision="allow")
